#!/bin/bash
# On-demand AirDrop receiver: idle on Bluetooth, wake on an iPhone's share sheet.
#
#   airdropd run          # foreground; this is what a waybar toggle starts
#   airdropd status       # one line of JSON for waybar
#   airdropd stop         # ask a running instance to exit
#   airdropd send <file>  # send TO a phone, borrowing a running stack if there
#                         # is one. This is what the Thunar right-click calls.
#
# THE MODEL (FINDINGS §39). A Mac does not hold AWDL up permanently either. It
# scans BLE continuously - which costs nothing on the Wi-Fi side - and brings
# AWDL up only when an iPhone announces, by opening its share sheet, that it
# wants to send something. We can do the same: the stack measures 0.19 s to
# come up, so there is no reason to hold the radio hostage between transfers.
#
# That also sidesteps the §38 dilemma. Rather than choosing once between "no
# internet" and "locked to the AP's channel", the choice is made per transfer,
# and the radio is only committed while something is actually happening.
#
# Layers reused from airdrop.sh; this file is orchestration only. airdrop.sh
# stays the research harness and is not imported, because its value is its
# commentary and its willingness to be slow and thorough - the opposite of
# what a bar toggle wants.
set -u

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"

# Prefer the root-owned installed copies. The in-repo fallbacks exist so the
# daemon can be exercised from a checkout, but they must NEVER be the paths in
# sudoers: this tree is writable by the invoking user, and NOPASSWD on a script
# the user can edit is a straight escalation to root. See daemon/README.md.
HELPER="${AIRDROP_HELPER:-/usr/local/bin/airdrop-helper}"
[ -x "$HELPER" ] || HELPER="$HERE/airdrop-helper"
BLE_WATCH="${AIRDROP_BLE_WATCH:-/usr/local/bin/airdrop-ble-watch}"
[ -x "$BLE_WATCH" ] || BLE_WATCH="$HERE/ble-watch"
CONFIRM="${AIRDROP_CONFIRM:-$HERE/airdrop-confirm}"
OWL_DIR="${OWL_DIR:-$HOME/owl}"
OWL="${OWL:-$OWL_DIR/build/daemon/owl}"
OPENDROP="${OPENDROP:-$OWL_DIR/.venv-opendrop/bin/opendrop}"
RECV_DIR="${RECV_DIR:-$HOME/Downloads}"

RUNDIR="${XDG_RUNTIME_DIR:-/tmp}/airdropd"
STATE="$RUNDIR/state.json"
LOCK="$RUNDIR/lock"
LOG="$RUNDIR/airdropd.log"
mkdir -p "$RUNDIR"

# How long to keep the stack up after a trigger with nothing arriving. The
# phone's share sheet stays open while the user picks a target, and mDNS over
# AWDL is slow (co-channel only a fraction of the time), so this cannot be
# tight. It is also the worst case for how long the radio is committed.
WINDOW="${AIRDROP_WINDOW:-90}"
# Ignore adverts weaker than this. An AirDrop transfer happens at arm's length;
# a faint advert is a stranger's phone in the next room and waking the radio for
# it is pure cost.
MIN_RSSI="${AIRDROP_MIN_RSSI:--70}"

# Opt-in P2P-GO mode (mt7921-dual-channel): picks AWDL's own channel
# independent of the AP's, instead of gambling on the AP's channel matching.
# Costs ~40-590ms added uplink latency the whole window it's up, and is not
# yet proven for a real file transfer or for ACKs on the resulting vif - so
# this defaults OFF. Set AIRDROP_DUALCHAN=1 to try it.
DUALCHAN="${AIRDROP_DUALCHAN:-0}"
# GO channel POLICY, fixed for the life of the daemon. "auto" = whatever
# go_target() decides at each bring-up: the station's channel when that is one
# we can build on, else the peer's, else ch149 for any other 5GHz station;
# anything else is an explicit override and is honoured as given. This value is
# never rewritten at runtime - the channel the
# GO currently sits on is BUILT_CHAN, and conflating the two is what previously
# turned "auto" into a constant after the first channel correction.
GO_CHAN="${AIRDROP_GO_CHAN:-auto}"
# The channels a GO can actually be built on. THREE PLACES MUST AGREE: this
# list, daemon/airdrop-helper (the `go-up` and `owl-start` cases), and owl's own
# switch in daemon/owl.c. They did not: the helper accepted 132 and owl rejects
# it, so a station on ch132 built a GO fine and then owl exited, which surfaces
# as the unrelated-looking "awdl0 never appeared". Validating here as well means
# an unbuildable channel is refused before anything is torn down, with a message
# that says which channel and why.
GO_CHANNELS="6 36 44 149"
# Where owl writes its log; the wrong-channel watch reads NO OVERLAP from it.
OWL_LOG="${AIRDROP_OWL_LOG:-/run/airdrop-owl.log}"
# Rebuild the GO on the peer's channel when ours stops overlapping it at all.
# The GO cannot retune in place (hostapd chan_switch FAILs on this phy), so
# "following" means a full teardown and bring-up - a few seconds of downtime.
# Set 0 to only warn, which leaves the bar red and the channel where it is.
GO_FOLLOW="${AIRDROP_GO_FOLLOW:-1}"
# Seconds of continuous zero overlap before acting. The phone reshuffles its
# sequence every few seconds and brief gaps are normal; this must be long
# enough not to chase them, since the response costs a stack rebuild.
WRONGCHAN_AFTER="${AIRDROP_WRONGCHAN_AFTER:-20}"

# Always-on mode: no BLE, no windows. Bring the stack up once and stay
# advertising until stopped, so the bar toggle is a plain on/off switch and
# "on" means "you can AirDrop to this machine right now" with no second step.
# The BLE path exists to avoid holding the radio when nobody is sending; with
# P2P-GO the cost of holding it is added uplink latency rather than losing the
# association, which is a trade worth making for a switch that just works.
ALWAYS="${AIRDROP_ALWAYS:-0}"

# How often opendrop re-sends its mDNS announcement while armed. The iPhone
# does not poll for AirDrop receivers; it only picks us up from an announce
# burst, so a receiver that announces once is invisible for all but the first
# few seconds of being on. Handled in-process by
# patches/opendrop-mdns-reannounce.patch and passed through as
# OPENDROP_ANNOUNCE_INTERVAL - it no longer costs a restart, so it can be
# frequent. 5s gives the phone a burst to catch well within the time it takes
# to open the share sheet.
REANNOUNCE="${AIRDROP_REANNOUNCE:-5}"

log() { printf '%s %s\n' "$(date +%H:%M:%S)" "$*" >> "$LOG"; }

# Is this a channel we can build a GO on? See GO_CHANNELS.
chan_supported() {
  case " $GO_CHANNELS " in *" ${1:-} "*) return 0 ;; esac
  return 1
}

# GO_CHAN above is POLICY and never changes for the life of the daemon: it is
# either "auto" or an explicit operator override, and both have to survive
# every rebuild. What the GO is actually built on right now is a different fact
# and lives here. Conflating the two is how auto mode died after one correction
# - the first time the wrong-channel watch fired it wrote the peer's channel
# into GO_CHAN, and from then on every bring-up reused that one number and the
# station was never consulted again.
BUILT_CHAN=""
# The managed (station) vif. Cached at script scope so the health watch can read
# the station's channel every tick without repeating the lookup, and invalidated
# by sta_channel() whenever a read comes back empty - the name is stable in
# normal operation but not across a driver reset.
STA=""
# The station's channel as of the last sta_channel() call; empty when unknown.
STA_CHAN=""
# WHY the channel is empty, which is a different question from whether it is,
# and the distinction the guards below turn on:
#
#   ok      - associated, STA_CHAN is its channel
#   unknown - a managed vif exists but has no channel right now: mid-roam,
#             scanning, or between associations
#   none    - there is no managed vif at all
#
# Only "none" is genuinely unconstrained. "unknown" is a station that is about
# to land somewhere, quite possibly on 2.4GHz, and treating it as "no
# constraint" is what let a blind ch149 GO get built during a roam.
STA_STATE=none

# BOTH OF THESE ASSIGN RATHER THAN PRINT, which is not a style choice: a
# caller writing ch=$(sta_channel) runs the whole thing in a subshell, so the
# interface name resolved inside it is discarded the moment it returns. The
# cache would never be warm, every tick would re-run the full `iw dev` scan,
# and - worse - invalidating the cache on a failed read would be a no-op,
# because there is nothing in this shell left to invalidate.
sta_iface() {
  [ -n "$STA" ] && return 0
  local ifs i
  ifs=$(iw dev 2>/dev/null | awk '/^\tInterface /{i=$2} /^\t\ttype managed/{print i}')
  # PREFER AN ASSOCIATED ONE. This used to take the first managed vif `iw dev`
  # happened to print, which is not the oldest or the primary - it is roughly
  # reverse creation order, so any second managed vif on the phy shadows the
  # real station. That was survivable while an unreadable station meant "no
  # constraint" and the bring-up carried on regardless; now that unreadable
  # means "wait", picking the wrong vif is an indefinite hold-off instead of a
  # wrong-but-moving daemon. Caught exactly this way in testing: a scratch
  # `sta1` vif made the daemon report the live, associated wlp2s0 as roaming.
  for i in $ifs; do
    if iw dev "$i" info 2>/dev/null | grep -q 'channel '; then STA="$i"; return 0; fi
  done
  # None associated - fall back to the first, which may simply be mid-roam.
  STA=$(printf '%s\n' $ifs | head -1)
  [ -n "$STA" ]
}

# Read the station's CURRENT channel into STA_CHAN, and WHY it is what it is
# into STA_STATE. Returns 0 only when the channel was actually read.
#
# The tri-state is the whole point. This used to report "no channel" for two
# completely different situations - no managed vif at all, and a managed vif
# that is simply mid-roam - and every caller then read the empty string as "the
# station imposes no constraint". A roaming station imposes the STRONGEST
# constraint we have: it is about to associate somewhere, and if that somewhere
# is 2.4GHz then a GO built during the gap is the configuration measured to
# kill the link. The gap is a second or two, which is exactly long enough for a
# bring-up to fall through it.
sta_channel() {
  STA_CHAN=""; STA_STATE=none
  sta_iface || return 1
  local info
  if ! info=$(iw dev "$STA" info 2>/dev/null) || [ -z "$info" ]; then
    # The vif we cached has gone, rather than merely gone quiet - renamed, or
    # removed by a driver reset. Drop the cache and re-resolve once; a cache
    # that never expires turns a rename into a permanently absent station.
    # Note this is NOT the unassociated case: an unassociated vif still prints
    # its `iw dev <if> info` block, just without a channel line, so it lands
    # below as "unknown" and keeps the cache.
    STA=""
    sta_iface || return 1
    info=$(iw dev "$STA" info 2>/dev/null) || { STA=""; return 1; }
  fi
  STA_CHAN=$(printf '%s' "$info" | grep -oP 'channel \K[0-9]+')
  if [ -n "$STA_CHAN" ]; then STA_STATE=ok; return 0; fi
  STA_STATE=unknown
  return 1
}

# Which channel should the GO be built on, and why? Sets GO_TARGET, GO_REASON,
# and on failure GO_FAIL (band|chan). Returns 1 when no GO can be built at all.
#
# PRECEDENCE: THE STATION FIRST, the peer only as a fallback. This is the
# inverse of what the wrong-channel watch used to do, and the measurement is
# unambiguous about which way round it goes. With the AP on ch36 the phone
# advertised
#   36,36,149,0,0,0,0,36,6,36,149,36,0,0,0,36
# - six slots of 36 against two of 149. Following the peer to its "dominant"
# 149 bought 2/16 overlap: owl synced, saw the phone at rssi -28, and not one
# IPv6 packet crossed in 60s with the share sheet open. Sitting on the station's
# ch36 is 6/16 of the same sequence AND is the pairing measured to hold the
# association (ch36+ch36 held; ch36+ch149 held the link but carried nothing).
#
# So the peer's channel is not evidence about where WE should be. It is only
# useful when the station cannot tell us anything: unreadable, or on a channel
# no GO can be built on.
go_target() {
  local peer="${1:-}" sta_chan
  GO_TARGET=""; GO_REASON=""; GO_FAIL=""

  sta_channel
  sta_chan="$STA_CHAN"

  # AN UNREADABLE STATION IS UNKNOWN, NOT UNCONSTRAINED. This is checked before
  # everything else because it is the case that used to skip everything else:
  # each rule below is written `[ -n "$sta_chan" ] && ...`, so an empty read
  # fell past all three and landed on the last-resort ch149 arm - the single
  # most dangerous thing to do without knowing the station's band. Observed
  # live 2026-08-04: the daemon refused correctly on ch11 at 10:05, then at
  # 10:11, mid-roam, read nothing and built a GO on ch149 blind.
  #
  # A vif that exists but has no channel is between associations. It will have
  # one again within a second or two, so the answer is to wait and ask again,
  # not to guess. Distinct from the `chan` failure so stack_up_retry can retry
  # in seconds rather than backing off to a minute.
  if [ "$STA_STATE" = unknown ]; then
    GO_FAIL=unknown
    GO_REASON="station ${STA:-?} has no channel right now (mid-roam or unassociated); not guessing"
    return 1
  fi

  # The whole point of P2P-GO mode is keeping the internet, so refuse the
  # combination that provably cannot hold it. Measured 2026-08-03, one evening,
  # same chip and phone:
  #
  #   STA ch2  + GO ch149  -> association lost ("Connection to AP lost" 1/s)
  #   STA ch2  + GO ch6    -> association lost, though both are 2.4GHz
  #   STA ch36 + GO ch149  -> held, 60s clean, 0% loss to the gateway
  #   STA ch36 + GO ch36   -> held
  #
  # So the predictor is NOT whether the two channels share a band - the ch6
  # case rules that out. It is the STA's own band: a 2.4GHz association does
  # not survive a second chanctx at all, a 5GHz one does. Refuse up front,
  # because a bar switch that silently drops your network is worse than one
  # that declines to turn on and says why. Checked here rather than in
  # stack_up so that a caller can ask "could we?" without tearing anything down.
  if [ -n "$sta_chan" ] && [ "$sta_chan" -le 14 ]; then
    GO_FAIL=band
    GO_REASON="STA is on 2.4GHz ch$sta_chan; a GO alongside it drops the link"
    return 1
  fi

  # An explicit override is an instruction, not a guess - it outranks both.
  if [ "$GO_CHAN" != auto ]; then
    if chan_supported "$GO_CHAN"; then
      GO_TARGET="$GO_CHAN"; GO_REASON="AIRDROP_GO_CHAN=$GO_CHAN (explicit)"
      return 0
    fi
    GO_FAIL=chan
    GO_REASON="AIRDROP_GO_CHAN=$GO_CHAN is not one of $GO_CHANNELS"
    return 1
  fi

  if [ -n "$sta_chan" ] && chan_supported "$sta_chan"; then
    GO_TARGET="$sta_chan"
    GO_REASON="following STA ${STA:-?} on ch$sta_chan"
    return 0
  fi

  if [ -n "$peer" ] && chan_supported "$peer"; then
    GO_TARGET="$peer"
    if [ -n "$sta_chan" ]; then
      GO_REASON="STA ch$sta_chan cannot host a GO ($GO_CHANNELS); falling back to the peer's ch$peer"
    else
      GO_REASON="STA channel unreadable; falling back to the peer's ch$peer"
    fi
    return 0
  fi

  # The STA is on 5GHz but not on a channel we can build a GO on - ch157 on
  # the "student" network is the case that found this, and any 5GHz channel
  # outside $GO_CHANNELS lands here. Refusing outright was wrong: the rule the
  # 2.4GHz guard above encodes is that the association survives a second
  # chanctx iff the STA is on 5GHz, and it says nothing about the two channels
  # matching (STA ch36 + GO ch149 held clean). So a 5GHz STA can host a GO on
  # 149 regardless of which 5GHz channel it is itself on - confirmed on
  # 2026-08-04, STA ch157 + GO ch149: armed, and the association held for the
  # whole 60s with no "Connection to AP lost" at all. It is not free, and the
  # numbers here are the dualchan uplink cost rather than a broken link -
  # 59/60 to the gateway, avg 164ms / max 473ms against a 30/30, avg 20ms /
  # max 167ms baseline on the same (busy) network minutes earlier. That sits
  # inside the ~40-590ms DUALCHAN already documents. 149 rather than 36/44
  # because it is a standard AWDL social channel, so the phone scans it anyway.
  #
  # Below the peer hint deliberately: if we can see the peer and it is on a
  # buildable channel, its real channel beats a blind guess.
  if [ -n "$sta_chan" ] && [ "$sta_chan" -gt 14 ]; then
    GO_TARGET=149
    GO_REASON="STA ch$sta_chan is 5GHz but not buildable ($GO_CHANNELS); using ch149"
    return 0
  fi

  # Nothing to go on from either side. Build something rather than nothing -
  # this is the old ${sta_chan:-149} fallback, kept, but now it says so.
  #
  # STA_STATE=none is load-bearing here and is the narrowing that fixes the
  # blind-ch149 bug: this arm may only fire when there is genuinely NO managed
  # vif, which is a machine with nothing to protect. It used to fire on any
  # empty read, and the overwhelmingly common empty read is a station that has
  # a vif, has an association a moment ago and will have one again - i.e. the
  # one case where guessing can cost the user their Wi-Fi.
  if [ "$STA_STATE" = none ] && [ -z "$peer" ]; then
    GO_TARGET=149
    GO_REASON="no STA channel and no peer hint - last-resort ch149"
    return 0
  fi

  GO_FAIL=chan
  GO_REASON="cannot follow: STA ch${sta_chan:-?}, peer ch${peer:-none}, buildable are $GO_CHANNELS"
  return 1
}

# State is written for waybar to read. Keep it a single line and always
# rewrite atomically: waybar polls on its own schedule and a half-written file
# is a parse error on the bar.
set_state() {
  local st="$1" detail="${2:-}"
  printf '{"state":"%s","detail":"%s","ts":%s}\n' "$st" "$detail" "$(date +%s)" \
    > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"
}

# avahi-daemon binds 5353 and answers for this host on awdl0 too, so with it
# running the phone can get avahi's reply (which carries no _airdrop._tcp
# record) instead of opendrop's, and we simply never appear. airdrop.sh has
# always stopped it for the duration; the daemon path never did.
avahi_stop() {
  AVAHI_WAS=""
  if pgrep -x avahi-daemon >/dev/null 2>&1; then
    AVAHI_WAS=1
    sudo -n "$HELPER" avahi-down >/dev/null 2>&1
    log "avahi-daemon stopped for this session (restored on exit)"
  fi
}

avahi_restore() {
  if [ -n "${AVAHI_WAS:-}" ]; then
    sudo -n "$HELPER" avahi-up >/dev/null 2>&1
    AVAHI_WAS=""
  fi
}

# --- temporary 5GHz band lock -------------------------------------------------
#
# A 2.4GHz station cannot host a GO alongside it (see go_target), and the old
# behaviour was to refuse and leave the switch red until the user went and
# changed networks by hand. On a dual-band SSID that is a pointless dead end:
# the 5GHz BSS is right there, the station just happened to pick the other one.
# So take it - for the session only - and give it back when the switch goes off.
#
# Scoped like avahi_stop/avahi_restore: changed on the way up, restored on the
# way down, and restorable by a LATER run if this one dies without cleaning up,
# because the change outlives the process (it is written into the saved NM
# profile on disk, not just the running connection).
BAND_LOCK_FILE="$RUNDIR/band_lock"
# Set once a lock is in force, so a bring-up that refuses on the band rule
# knows whether locking has already been tried and failed - otherwise a
# station that stays on 2.4GHz would relock on every retry, reassociating
# the user's Wi-Fi in a loop.
BAND_LOCKED=""

# The NM connection currently active on the station, or empty.
sta_connection() {
  sta_iface || return 1
  nmcli -t -f GENERAL.CONNECTION device show "$STA" 2>/dev/null \
    | sed -n 's/^GENERAL.CONNECTION://p' | head -1 | grep -v '^--$'
}

# Does the SSID we are on actually have a 5GHz BSS? Locking the band to `a`
# when it does not is not a degraded AirDrop, it is no Wi-Fi at all: NM would
# find no matching AP and simply fail to activate. Never lock without checking.
has_5ghz_bss() {
  local ssid="$1"
  [ -n "$ssid" ] || return 1
  nmcli -t -f SSID,FREQ device wifi list --rescan no 2>/dev/null \
    | sed 's/\\:/\x01/g' \
    | awk -F: -v s="$ssid" '{gsub(/\x01/,":",$1)} $1==s && $2+0 >= 4900 {found=1} END{exit !found}'
}

band_lock_engage() {
  local conn ssid prev i
  conn=$(sta_connection) || return 1
  [ -n "$conn" ] || return 1
  ssid=$(nmcli -t -f 802-11-wireless.ssid connection show "$conn" 2>/dev/null \
    | sed -n 's/^802-11-wireless.ssid://p')
  if ! has_5ghz_bss "$ssid"; then
    log "no 5GHz BSS for SSID '$ssid' - cannot lock the band, refusing instead"
    return 1
  fi
  prev=$(nmcli -t -f 802-11-wireless.band connection show "$conn" 2>/dev/null \
    | sed -n 's/^802-11-wireless.band://p')

  # Record BEFORE changing anything. If we die between the modify and the
  # restore, the next run reads this and puts the profile back - the whole
  # reason the record is a file rather than a variable.
  printf '%s\n%s\n' "$conn" "$prev" > "$BAND_LOCK_FILE"

  log "station is on 2.4GHz - locking '$conn' to 5GHz for this session (was '${prev:-both bands}')"
  if ! nmcli connection modify "$conn" 802-11-wireless.band a >/dev/null 2>&1; then
    log "band lock FAILED: nmcli connection modify was refused"
    rm -f "$BAND_LOCK_FILE"
    return 1
  fi
  BAND_LOCKED=1

  # Reactivate so the new constraint is applied. `connection up` alone, never
  # a disconnect followed by a connect: on an NM-managed device those two
  # activations race NM's own autoconnect, and the observed result was an
  # association that lasted about a second and then deauthenticated with no
  # retry.
  nmcli connection up "$conn" >/dev/null 2>&1

  # Wait for it to actually land on 5GHz. The bring-up that called us is about
  # to read the station's channel and must not read it mid-reassociation - that
  # is the very bug the other half of this change is about.
  for i in $(seq 30); do
    sleep 1
    sta_channel
    if [ "$STA_STATE" = ok ] && [ "$STA_CHAN" -gt 14 ]; then
      log "station reassociated on 5GHz ch$STA_CHAN"
      return 0
    fi
  done
  log "band lock engaged but the station has not reached 5GHz after 30s"
  return 1
}

# Put the profile back exactly as it was. Restores the SETTING only and does
# not reactivate: the station is happily on 5GHz by now, and forcing another
# activation just to allow 2.4GHz again would bounce the link a second time on
# the way out, for no benefit. It will roam back on its own if it wants to.
band_lock_release() {
  [ -s "$BAND_LOCK_FILE" ] || return 0
  local conn prev
  conn=$(sed -n 1p "$BAND_LOCK_FILE")
  prev=$(sed -n 2p "$BAND_LOCK_FILE")
  if [ -n "$conn" ]; then
    nmcli connection modify "$conn" 802-11-wireless.band "$prev" >/dev/null 2>&1 \
      && log "released the 5GHz lock on '$conn' (band back to '${prev:-both bands}')" \
      || log "could not release the 5GHz lock on '$conn' - check 802-11-wireless.band"
  fi
  rm -f "$BAND_LOCK_FILE"
  BAND_LOCKED=""
}

teardown() {
  avahi_restore
  sudo -n "$HELPER" owl-stop >/dev/null 2>&1
  [ -n "${OD_PID:-}" ] && kill "$OD_PID" 2>/dev/null
  if [ "$DUALCHAN" = 1 ]; then
    sudo -n "$HELPER" go-down >/dev/null 2>&1
  else
    sudo -n "$HELPER" down >/dev/null 2>&1
  fi
  log "stack down"
}

cleanup() {
  teardown
  [ -n "${BLE_PID:-}" ] && kill "$BLE_PID" 2>/dev/null
  # The health watcher outlives opendrop if we exit mid-window; left running it
  # would rewrite the state file after we set it to off, so the bar would show
  # an error for a daemon that is no longer there.
  [ -n "${HEALTH_PID:-}" ] && kill "$HEALTH_PID" 2>/dev/null
  # After the radio is down, so the station is free to go wherever it likes the
  # moment both bands are allowed again.
  band_lock_release
  set_state off
  log "airdropd exiting"
}

# One transfer window: bring the stack up, advertise, wait, tear down.
# Everything here is bounded - a bar toggle that can wedge is worse than one
# that occasionally misses a transfer.
# Bring the radio stack up and leave awdl0 ready. Sets BUILT_CHAN on success.
# Shared by the BLE-triggered window and the always-on switch so the two
# cannot drift apart - the P2P-GO bring-up is the fiddly part and there must
# only ever be one copy of it.
#
#   stack_up [peer_chan]
#
# peer_chan is what the peer's sequence says it wants, when we have that. It is
# a hint for this bring-up only and is deliberately NOT remembered anywhere: the
# next bring-up resolves the channel again from scratch.
stack_up() {
  local peer_hint="${1:-}"
  local up chan owlargs

  local go_chan=""
  if [ "$DUALCHAN" = 1 ]; then
    # Resolve the channel from scratch, LIVE, on every single bring-up - the
    # station is read here and nowhere else is it remembered. A rebuild exists
    # precisely because something moved, and the station is the thing most
    # likely to have moved. All the policy, and the reason for it, is in
    # go_target(); this only has to report what it decided and act on it.
    if ! go_target "$peer_hint"; then
      # A 2.4GHz station is not a dead end on a dual-band SSID - the 5GHz BSS
      # is usually sitting right there and the station simply picked the other
      # one. Take it for the session rather than refusing and leaving the user
      # to go and change networks by hand. Only ever attempted ONCE per run:
      # if the lock is already in force and the station is STILL on 2.4GHz,
      # relocking would reassociate the Wi-Fi on every retry tick.
      if [ "$GO_FAIL" = band ] && [ -z "$BAND_LOCKED" ]; then
        set_state switching "moving Wi-Fi to 5GHz so AirDrop can come up"
        if band_lock_engage && go_target "$peer_hint"; then
          : # locked, landed on 5GHz, and the retry resolved a channel
        else
          log "REFUSING: $GO_REASON"
          set_state error "Wi-Fi is on 2.4GHz and could not be moved to 5GHz"
          return 1
        fi
      else
        case "$GO_FAIL" in
          band)
            log "REFUSING: $GO_REASON"
            set_state error "Wi-Fi is on 2.4GHz; AirDrop needs a 5GHz AP" ;;
          unknown)
            # Not an error and not worth colouring the bar red: the station is
            # between associations and will have a channel again in a moment.
            # The switch IS on, so the bar keeps reading on while we wait.
            log "HOLDING OFF: $GO_REASON"
            set_state waking "waiting for the Wi-Fi to settle" ;;
          *)
            log "CANNOT FOLLOW: $GO_REASON"
            set_state unreachable "$GO_REASON" ;;
        esac
        return 1
      fi
    fi
    go_chan="$GO_TARGET"
    log "GO channel -> ch$go_chan ($GO_REASON)"
  fi
  if [ "$DUALCHAN" = 1 ]; then
    # P2P-GO mode: pick AWDL's channel ourselves instead of hoping the AP's
    # matches (mt7921-dual-channel). owl rides go0's own chanctx via mon0
    # (the single MAC-aliased vif go-up creates), not the AP's mon1 pair.
    if ! up=$(sudo -n "$HELPER" go-up "$go_chan" 2>&1); then
      log "helper go-up FAILED: $up"
      set_state error "no privilege or go0 setup failed - see README (sudoers)"
      return 1
    fi
    chan="$go_chan"
    # Run OWL on whichever vif go-up says can ACK - the `flags active` mon1 if
    # it came up, else the plain mon0. Unicast AWDL is unanswered without it.
    local ackvif
    ackvif=$(printf '%s' "$up" | grep -oP '"ackvif":"\K[^"]+')
    owlargs=(owl-start "$chan" "${ackvif:-mon0}")
    log "go0 up on ch $chan (P2P-GO mode, owl on ${ackvif:-mon0})"
  else
    if ! up=$(sudo -n "$HELPER" up 2>&1); then
      log "helper up FAILED: $up"
      set_state error "no privilege - see README (sudoers)"
      return 1
    fi
    chan=$(printf '%s' "$up" | grep -oP '"chan":\K[0-9]+')
    owlargs=(owl-start "${chan:-36}")
    log "stack up on ch ${chan:-?}"
  fi

  # OWL is started BY THE HELPER, as root. It creates the awdl0 tun interface
  # and cannot do that unprivileged - run as the user it starts, prints its
  # banner, and simply never produces awdl0, which reads as "awdl0 never
  # appeared" rather than as the permission problem it is. That cost one live
  # run against a real phone with the share sheet open.
  if ! sudo -n "$HELPER" "${owlargs[@]}" >/dev/null 2>&1; then
    log "owl-start failed - awdl0 never appeared (see /run/airdrop-owl.log)"
    set_state error "awdl0 failed"
    teardown
    return 1
  fi

  # awdl0 exists but its link-local address is not immediately bindable.
  # opendrop's zeroconf binds 5353 once at startup and does NOT retry: too
  # early and it logs "Address not available ... 5353" and then announces into
  # nothing, silently, while still looking healthy. airdrop.sh only avoids
  # this by accident, because its ping checks take ~20s first.
  local i
  for i in $(seq 40); do
    ip -6 addr show dev awdl0 scope link 2>/dev/null \
      | grep -q 'inet6 .*\(tentative\)' || \
      { ip -6 addr show dev awdl0 scope link 2>/dev/null | grep -q inet6 && break; }
    sleep 0.25
  done
  log "awdl0 link-local ready after $((i*250))ms"

  BUILT_CHAN="${chan:-?}"
  return 0
}

# Wait for a spawned opendrop to actually reach a listening socket.
#
# "Alive" is not "serving". opendrop binds, wraps the socket in TLS and only
# then calls serve_forever; anything that goes wrong in between can leave a
# process that is running, logging, and answering nothing - which from out here
# is indistinguishable from a healthy receiver until a phone tries to connect
# and sits on "Waiting".
#
# ss -tlnp, and all three parts matter. -l is what restricts it to LISTEN: a
# plain `ss -tnp` lists established connections only, so a listener with no
# connection to it never appears (this is what made a working socket look
# missing during one debugging session). -p is what attaches the process, and
# the name it prints is the COMM name - for the venv console script that is
# "opendrop", not "python", so grepping for python finds nothing either. The
# pid is what is actually matched on below, because it is the one identifier
# that cannot alias with another process on the box.
#
# Once per spawn, not per tick: the answer cannot change from "never listened"
# to "listening" later, and a subprocess every 5s forever to learn nothing is
# exactly the kind of cost this loop has been kept free of.
#
# The pid we hold is the one bash reported for `( cd … && opendrop ) &`. Bash
# exec-optimises that subshell away, so in practice it IS opendrop's pid
# (verified live: python's parent was the daemon, with no bash in between) -
# but that is an optimisation, not a promise, so a child of it counts too.
wait_for_listener() {
  local pid="$1" i p pids sockets
  # 100 ticks of 0.1s, plus the ss/pgrep each tick costs - about 15s of wall
  # clock before giving up, measured. Measured cold start to "Starting HTTPS
  # server" is ~1.5s (python startup, cert load, zeroconf), so this is
  # generous by design: a false "not listening" would kill a receiver that
  # was merely slow, and it only ever runs to the end when something is
  # actually broken.
  for i in $(seq 100); do
    kill -0 "$pid" 2>/dev/null || return 1
    pids="$pid $(pgrep -P "$pid" 2>/dev/null | tr '\n' ' ')"
    sockets=$(ss -tlnpH 2>/dev/null)
    for p in $pids; do
      case "$sockets" in *"pid=$p,"*) return 0 ;; esac
    done
    sleep 0.1
  done
  return 1
}

# Block until the station is associated on 5GHz again. Used after the 2.4GHz
# guard has torn the GO down: there is no point retrying a bring-up, because
# go_target would refuse on the same rule every time and each attempt would only
# add a log line. Waiting costs nothing and re-arms by itself the moment the
# station is somewhere a GO can coexist with it.
#
# Deliberately does NOT re-arm on an unreadable channel. Empty means no
# association at all, and coming back up on the last-resort ch149 against an
# unknown station is exactly the gamble this guard exists to stop taking.
wait_for_5ghz() {
  # Same dead end the bring-up refusal used to be, for the same reason, so it
  # gets the same answer: if the SSID has a 5GHz BSS, take it rather than
  # waiting for the user to notice and go and change networks. Once only -
  # BAND_LOCKED makes a second call here a no-op, so a station that keeps
  # falling back to 2.4GHz is waited out rather than reassociated in a loop.
  if [ -z "$BAND_LOCKED" ]; then
    set_state switching "moving Wi-Fi back to 5GHz"
    band_lock_engage && { log "station back on 5GHz ch$STA_CHAN - re-arming"; return 0; }
  fi
  log "holding off until the station is back on 5GHz"
  while :; do
    sleep 5
    sta_channel
    # STA_STATE, not a non-empty channel: an unreadable station is mid-roam and
    # re-arming into it would build the GO against an unknown band, which is
    # precisely what this guard exists to stop.
    if [ "$STA_STATE" = ok ] && [ "$STA_CHAN" -gt 14 ]; then
      log "station back on 5GHz ch$STA_CHAN - re-arming"
      return 0
    fi
  done
}

# stack_up, but it does not give up. A failed bring-up used to `break` out of
# serve_forever, which ended the daemon: the bar's switch went back to "drop
# off" and whatever went wrong - a momentary hostapd failure, the AP briefly
# on a band we cannot join - became permanent until someone clicked it again.
# An always-on switch that is on must keep trying, so the recoverable failures
# recover by themselves.
#
# stack_up has already written a specific state (and reason) for whatever it
# refused or failed on, so this deliberately does not overwrite it - it only
# says how long until the next attempt. Backoff caps at a minute: past that
# the cost of retrying is nil and the value of noticing quickly is not.
stack_up_retry() {
  local delay=5 tries=0 wait_s
  until stack_up "$@"; do
    tries=$((tries + 1))
    # An unreadable station is a second or two of roam, not a fault, so it gets
    # a short FIXED wait and does not touch the escalating backoff. Feeding it
    # through the normal ladder would be actively wrong: the gap closes in
    # about a second, and by the fourth attempt we would be sleeping 40s
    # waiting for something that resolved long ago. It also stays quiet in the
    # log - a roam printing "attempt N failed" reads like a fault.
    if [ "${GO_FAIL:-}" = unknown ]; then
      sleep 2
      continue
    fi
    wait_s="$delay"
    log "bring-up attempt $tries failed - retrying in ${wait_s}s"
    sleep "$wait_s"
    [ "$delay" -lt 60 ] && delay=$((delay * 2))
    [ "$delay" -gt 60 ] && delay=60
  done
  set_state armed "ch $BUILT_CHAN"
  log "advertising on ch $BUILT_CHAN until stopped"
  return 0
}

serve_window() {
  local trigger="$1"
  log "trigger from $trigger - bringing stack up"
  set_state waking "$trigger"

  stack_up || return 1

  set_state armed "ch $BUILT_CHAN"
  log "advertising for ${WINDOW}s"
  mkdir -p "$RECV_DIR"
  # AIRDROP_CONFIRM is what makes the patched handle_ask prompt. Without it
  # opendrop accepts silently, which is precisely what must not happen when
  # this is running unattended.
  ( cd "$RECV_DIR" && AIRDROP_CONFIRM="$CONFIRM" \
      timeout "$WINDOW" "$OPENDROP" -i awdl0 receive ) >> "$LOG" 2>&1 &
  OD_PID=$!
  wait "$OD_PID" 2>/dev/null
  OD_PID=""

  teardown
  set_state idle
  return 0
}

# Always-on: up once, advertise until stopped. opendrop is run in a loop
# because it exits after some transfers and on some malformed requests; in a
# timed window that just ended the window, but here it would silently turn a
# bar that still reads "on" into one that no longer receives anything. The
# radio stack stays up across the restart - only the HTTPS server is respawned.
serve_forever() {
  log "always-on mode - bringing stack up"
  set_state waking "switch"

  avahi_stop
  stack_up_retry

  mkdir -p "$RECV_DIR"

  # opendrop's HTTP server is single-threaded, so anything slow inside a
  # handler stops it accepting. The consent prompt is exactly that: at the
  # stock 45s, one unanswered prompt filled the listen backlog (Recv-Q 6 on a
  # backlog of 5) with iOS's own validation connects, which time out and make
  # the phone DROP the device from the share sheet - so a prompt nobody
  # answered also destroyed discovery for everyone. Keep the prompt, but bound
  # it tightly enough that the server frees up before iOS gives up on us.
  export AIRDROP_CONFIRM_TIMEOUT="${AIRDROP_CONFIRM_TIMEOUT:-15}"

  while :; do
    # -d matches airdrop.sh's invocation. Without it opendrop logs only
    # "File(s) received (size 0.00 MB)" with no request headers, so a transfer
    # that arrives empty is indistinguishable from one that never carried a
    # payload - there is no TotalBytes to compare against. PYTHONUNBUFFERED so
    # the lines reach the log file as they happen rather than sitting in an
    # 8 KiB block buffer, which matters when reading it live during a transfer.
    ( cd "$RECV_DIR" && AIRDROP_CONFIRM="$CONFIRM" PYTHONUNBUFFERED=1 \
        OPENDROP_ANNOUNCE_INTERVAL="$REANNOUNCE" \
        "$OPENDROP" -d -i awdl0 receive ) >> "$LOG" 2>&1 &
    OD_PID=$!

    # A receive process with no listening socket is a failed bring-up, not a
    # running receiver. Say so and start over rather than arming the bar over
    # a process that cannot be connected to - that failure is invisible from
    # the phone's side until someone actually tries to send, and then it looks
    # like the transfer failing rather than the receiver never having been up.
    if ! wait_for_listener "$OD_PID"; then
      log "FAILED BRING-UP: opendrop is alive but never opened a listening socket"
      set_state error "receiver never started listening - see the log"
      kill "$OD_PID" 2>/dev/null
      wait "$OD_PID" 2>/dev/null
      OD_PID=""
      # Respawning is the right response: the plausible causes (a port still
      # held from the last run, a transient failure inside its startup) are
      # ones a fresh process clears, and the radio stack underneath is not
      # implicated. Bounded so a permanent fault is one line every 5s rather
      # than a spin.
      sleep 5
      continue
    fi

    # Watch the stack while opendrop runs. Without this the bar keeps saying
    # "on" after owl or the GO has died underneath it - the state file is
    # written once at bring-up and never revisited, so a dead receiver is
    # indistinguishable from a working one right up until a transfer fails.
    # A switch that claims to be on when it is not is worse than one that is
    # simply off.
    ( elapsed=0; no_overlap=0
      while kill -0 "$OD_PID" 2>/dev/null; do
        sleep 5
        elapsed=$((elapsed + 5))
        sta_channel; sta_now="$STA_CHAN"

        # Same fail-open as go_target had, with the same consequence: the 2.4GHz
        # guard below is `[ -n "$sta_now" ] && ...`, so a station caught between
        # associations skipped it entirely and the GO stayed up through the one
        # window in which the station is most likely to land on 2.4GHz. Waiting
        # a full 5s tick to look again is a long time to hold a configuration
        # that drops the link, so resolve it now with a few fast polls instead.
        # Deliberately bounded and short: if it is still unreadable after this
        # the station is properly down rather than roaming, there is no
        # association to protect at the moment, and the next tick will catch it
        # the instant one comes back.
        if [ "$STA_STATE" = unknown ]; then
          for _ in 1 2 3 4; do
            sleep 1
            sta_channel; sta_now="$STA_CHAN"
            [ "$STA_STATE" = ok ] && break
          done
        fi

        # 2.4GHz GUARD. The measurement behind go_target's bring-up refusal is
        # not a property of the moment we start: a 2.4GHz station cannot hold
        # its association alongside a second chanctx AT ALL, whenever the two
        # come to coexist. Until now the rule ran once, at bring-up, so a
        # station that roamed onto 2.4GHz while the GO was up walked straight
        # into the configuration the refusal exists to prevent - and the first
        # symptom is the network dropping, not AirDrop failing.
        #
        # So this is checked first, before liveness and before the channel
        # watch, and it is acted on here rather than signalled to the parent:
        # every tick of delay is a tick of "Connection to AP lost". Protecting
        # the Wi-Fi outranks keeping AirDrop up, so the GO goes down now and
        # argues later. No retry - a bring-up would only refuse on the same
        # rule - just a wait for the station to come back to 5GHz.
        if [ -n "$sta_now" ] && [ "$sta_now" -le 14 ]; then
          log "STATION ON 2.4GHz ch$sta_now - tearing the GO down to protect the association"
          sudo -n "$HELPER" owl-stop >/dev/null 2>&1
          sudo -n "$HELPER" go-down >/dev/null 2>&1
          set_state error "Wi-Fi moved to 2.4GHz (ch$sta_now); AirDrop is off until it is back on 5GHz"
          : > "$RUNDIR/sta_24"
          kill "$OD_PID" 2>/dev/null
          break
        fi

        if ! ip link show awdl0 >/dev/null 2>&1 || ! pgrep -x airdrop-owl >/dev/null; then
          set_state error "stack died (awdl0 or owl gone) - toggle off and on"
          log "HEALTH: awdl0 or owl vanished while armed"
          break
        fi
        # Re-announcing lives INSIDE opendrop now (patches/opendrop-mdns-
        # reannounce.patch), which is the whole reason this loop no longer
        # kills it. Doing it from out here meant killing the process and
        # letting it re-register: that deregistered the service and dropped
        # the HTTPS listener for ~1.5s every REANNOUNCE seconds, so the
        # receiver appeared and vanished on the phone's share sheet on a
        # 30s period. The in-process version re-sends the records without
        # ever taking the registration or the listener down, so it also does
        # not need the mid-transfer guard this loop used to carry.

        # WRONG-CHANNEL WATCH. The GO holds the radio on one channel and the
        # phone's sequence moves underneath us - observed shifting 36 -> 149
        # and back inside one evening, and following the phone's own AP band.
        # When our channel appears in none of the phone's slots there is no
        # path to it at all, yet every health signal above still reads green:
        # owl alive, awdl0 up, opendrop listening, mDNS leaving the radio.
        # That is exactly how this failed silently before. owl logs NO OVERLAP
        # with the channel the peer actually wants; surface it rather than let
        # the bar keep claiming to be on.
        if [ -r "$OWL_LOG" ]; then
          # Compare the two events by their own timestamps rather than by how
          # much log has gone past. owl at -vv emits trace at a rate that makes
          # any fixed byte window meaningless - it can cover a second or a
          # minute depending on how busy the air is. Whichever line is NEWER is
          # the current state, and that holds at any log rate.
          last_none=$(grep -a "NO OVERLAP" "$OWL_LOG" 2>/dev/null | tail -1)
          last_over=$(grep -a "intersect:" "$OWL_LOG" 2>/dev/null | tail -1)
          want=$(printf '%s' "$last_none" | grep -oP 'peer wants ch \K[0-9]+')
          kept=$(printf '%s' "$last_over" | grep -oP 'intersect: \K[0-9]+')
          # Which of the two is the CURRENT state - compared by owl's own
          # timestamps, since at -vv no fixed byte window means anything.
          overlapping=1
          [ -n "$last_none" ] && [ "${last_none%% *}" \> "${last_over%% *}" ] \
            && overlapping=""

          # THE ONE LINE THAT HAS ALL THREE CHANNELS IN IT. Until now the
          # station's channel, the GO's channel and the peer's lived in three
          # different places at three different times - two of them in a
          # different process's log - so "AirDrop stopped working" could not be
          # attributed after the fact to a roam, to the phone's sequence moving,
          # or to neither. One line a tick, from the loop that was already
          # running: no new process beyond the iw read, no new privilege.
          #
          # peer= is only knowable when owl says it has no overlap; while we DO
          # overlap, owl reports the count and not the peer's dominant channel,
          # so the last known value is marked ~stale rather than reprinted as
          # though it were current.
          if [ -n "$overlapping" ]; then
            log "CHAN sta=ch${sta_now:-?} go=ch$BUILT_CHAN peer=ch${want:-?}~stale overlap=${kept:-0}/16"
          else
            log "CHAN sta=ch${sta_now:-?} go=ch$BUILT_CHAN peer=ch${want:-?} overlap=0/16"
          fi

          if [ -z "$overlapping" ] \
             && [ -n "$want" ] && [ "$want" != "0" ] && [ "$want" != "$BUILT_CHAN" ]; then
            no_overlap=$((no_overlap + 5))
          else
            no_overlap=0
            # A refusal leaves "unreachable" on the bar. The phone coming back
            # onto our channel has to clear it, or the switch stays red while
            # it is in fact receiving - the same class of lie as claiming to be
            # on when the stack is dead. Only rewrite when it is actually wrong.
            grep -q '"state":"armed"' "$STATE" 2>/dev/null \
              || set_state armed "ch $BUILT_CHAN"
          fi
          # Hysteresis: the phone reshuffles its sequence every few seconds and
          # a momentary gap is normal. Only act once it has been unreachable
          # for a sustained stretch.
          if [ "$no_overlap" -ge "$WRONGCHAN_AFTER" ]; then
            # Ask the precedence BEFORE killing opendrop. Under station-first
            # the common answer is "stay where you are", and acting on the old
            # assumption that a wrong channel always means a rebuild would tear
            # the HTTPS listener and the mDNS registration down every
            # WRONGCHAN_AFTER seconds to accomplish nothing.
            if [ "$GO_FOLLOW" = 1 ] && [ "$DUALCHAN" = 1 ] \
               && go_target "$want" && [ "$GO_TARGET" != "$BUILT_CHAN" ]; then
              log "WRONG CHANNEL: on ch $BUILT_CHAN, phone wants ch $want - rebuilding on ch $GO_TARGET ($GO_REASON)"
              set_state waking "moving to ch $GO_TARGET"
              # The GO cannot retune in place: hostapd chan_switch returns FAIL
              # for every parameter form, including a same-subband 149->153 hop,
              # and this phy advertises no channel-switch support (tested
              # 2026-08-03). Rebuilding is the only way to change it. This runs
              # in a subshell, so leave the channel where the parent can see it
              # and stop opendrop; serve_forever's loop does the rebuild.
              echo "$want" > "$RUNDIR/want_chan"
              kill "$OD_PID" 2>/dev/null
              break
            else
              # Either following is off, or the precedence says our channel is
              # still the right one to be on. Either way the phone cannot see
              # us, which the bar has to say - but opendrop keeps running,
              # because nothing about the stack is broken.
              log "WRONG CHANNEL: on ch $BUILT_CHAN, phone wants ch $want - staying (${GO_REASON:-following is off})"
              set_state unreachable "phone is on ch$want; we are on ch $BUILT_CHAN"
            fi
            no_overlap=0
          fi
        fi
      done ) &
    HEALTH_PID=$!

    wait "$OD_PID" 2>/dev/null
    OD_PID=""
    kill "$HEALTH_PID" 2>/dev/null
    HEALTH_PID=""

    # The 2.4GHz guard has already taken the GO down - the radio is safe and
    # the state file says why. All that is left is to wait for the station to
    # come back to 5GHz and re-arm on whatever channel it landed on. Checked
    # before the wrong-channel block because any pending channel request is
    # about a stack that no longer exists.
    if [ -e "$RUNDIR/sta_24" ]; then
      rm -f "$RUNDIR/sta_24" "$RUNDIR/want_chan"
      # Nothing of ours is on the radio now, and the station may sit on 2.4GHz
      # for hours, so give the system its mDNS responder back for the duration
      # rather than leaving .local resolution broken the whole time. Taken
      # again on the way back up, for the reason avahi_stop documents.
      avahi_restore
      wait_for_5ghz
      avahi_stop
      stack_up_retry
      log "opendrop exited - respawning"
      sleep 1
      continue
    fi

    # The wrong-channel watch asked for a different GO channel. Tear the radio
    # stack down and bring it back up there. Only the GO path can do this - on
    # the single-channel path owl retunes itself and there is nothing to rebuild.
    if [ -s "$RUNDIR/want_chan" ]; then
      want_chan=$(cat "$RUNDIR/want_chan"); rm -f "$RUNDIR/want_chan"
      # ASK BEFORE TEARING ANYTHING DOWN, and ask the same function the
      # bring-up will ask, so the answer cannot differ between deciding and
      # doing. Tearing the stack down first and discovering afterwards that the
      # target was unbuildable traded a working receiver on the wrong channel
      # for no receiver at all. A refusal has to be free: log it, say so on the
      # bar, leave the radio exactly as it is.
      if ! go_target "$want_chan"; then
        log "CANNOT FOLLOW to ch$want_chan: $GO_REASON - staying on ch $BUILT_CHAN"
        set_state unreachable "cannot follow to ch$want_chan; still on ch $BUILT_CHAN"
      elif [ "$GO_TARGET" = "$BUILT_CHAN" ]; then
        # The peer moved, we did not, and the station says stay. This is the
        # precedence doing its job rather than a failure - but we ARE now
        # invisible to that phone, so the bar must not keep saying "on".
        log "peer wants ch$want_chan; $GO_REASON - staying on ch $BUILT_CHAN"
        set_state unreachable "phone is on ch$want_chan; staying on ch $BUILT_CHAN with the Wi-Fi"
      else
        log "rebuilding stack on ch $GO_TARGET (was ch $BUILT_CHAN): $GO_REASON"
        sudo -n "$HELPER" owl-stop >/dev/null 2>&1
        sudo -n "$HELPER" go-down >/dev/null 2>&1
        # The peer's channel is passed in for THIS bring-up only. It used to be
        # written into GO_CHAN, which permanently replaced "auto" with one
        # number and stopped the station from ever being read again.
        stack_up_retry "$want_chan"
      fi
    fi
    HEALTH_PID=""
    log "opendrop exited - respawning"
    sleep 1
  done
}

cmd_run() {
  # Single instance. Without this a second toggle deletes the first's mon0
  # mid-transfer, which presents as a mysterious mid-file failure.
  exec 9>"$LOCK"
  if ! flock -n 9; then
    echo "airdropd: already running" >&2
    exit 1
  fi
  echo $$ >&9

  # ble-watch is only needed by the BLE-triggered path; always-on never runs
  # it, so do not make a missing one fatal for a mode that will not call it.
  local need=("$HELPER" "$CONFIRM" "$OWL" "$OPENDROP")
  [ "$ALWAYS" = 1 ] || need+=("$BLE_WATCH")
  for p in "${need[@]}"; do
    [ -x "$p" ] || { echo "airdropd: missing or not executable: $p" >&2; exit 1; }
  done
  if ! sudo -n "$HELPER" status >/dev/null 2>&1; then
    echo "airdropd: cannot run $HELPER without a password." >&2
    echo "  waybar has no tty, so this must be passwordless. See daemon/README.md." >&2
    exit 1
  fi
  if [ "$DUALCHAN" = 1 ] && [ ! -x /usr/local/bin/airdrop-go-hostapd ]; then
    echo "airdropd: AIRDROP_DUALCHAN=1 but /usr/local/bin/airdrop-go-hostapd is missing." >&2
    echo "  See daemon/README.md - install the mt7921-dual-channel hostapd build there." >&2
    exit 1
  fi

  trap 'cleanup; exit 0' INT TERM
  trap cleanup EXIT

  : > "$LOG"
  # Both are requests from a previous run's health watch. Surviving a crash,
  # they would be acted on against a stack that has nothing to do with them.
  rm -f "$RUNDIR/sta_24" "$RUNDIR/want_chan"

  # A band lock is written into the saved NM profile, so unlike everything else
  # here it outlives the process that set it. A previous run that was killed
  # rather than stopped leaves the user's Wi-Fi pinned to 5GHz indefinitely,
  # with nothing on the bar to say so. Put it back before doing anything else -
  # if this run needs the lock again it will take it again a moment later, and
  # taking it is idempotent.
  band_lock_release

  if [ "$ALWAYS" = 1 ]; then
    log "airdropd started in always-on mode (dualchan=$DUALCHAN)"
    serve_forever
    return $?
  fi

  set_state idle
  log "airdropd started; watching BLE for AirDrop adverts (min rssi $MIN_RSSI)"

  # ble-watch needs root for btmon. It is long-lived and its output drives the
  # loop, so it is the one thing started under sudo up front rather than per
  # transfer.
  #
  # Via a FIFO rather than a process substitution so we hold a real PID to kill
  # on the way out. Bash does not set $! for `< <(...)`, and an unkillable
  # ble-watch means an orphaned btmon plus a btmgmt scanner running forever
  # after the toggle is switched off.
  FIFO="$RUNDIR/ble.fifo"
  rm -f "$FIFO"; mkfifo "$FIFO"
  sudo -n "$BLE_WATCH" --min-rssi "$MIN_RSSI" --cooldown 30 2>>"$LOG" > "$FIFO" &
  BLE_PID=$!

  local line addr rssi
  while IFS= read -r line; do
    addr=$(printf '%s' "$line" | grep -oP '"addr": "\K[^"]+')
    rssi=$(printf '%s' "$line" | grep -oP '"rssi": \K-?[0-9]+')
    serve_window "${addr:-?} (${rssi:-?} dBm)"
  done < "$FIFO"
}

# --- sending ------------------------------------------------------------------
#
# `airdropd send <file>...` exists because until now there was NO send path that
# could coexist with the receiver. Sending meant airdrop.sh, which rebuilds
# layers 1-4 from scratch: with the bar toggle on, that takes the flock this
# daemon holds, and if it got past that it would delete the mon0 the running
# stack is using, mid-transfer. So the two tools could not both be on.
#
# Two modes, decided by whether anything already holds the lock:
#
#   ATTACH - the daemon is running and the stack is up. Borrow it. Nothing is
#            brought up, nothing is torn down, and the state file is left
#            entirely alone, because "armed" is still true: we are receiving
#            throughout. This is the fast path and the one a right-click uses.
#   OWN    - nothing is running. Take the lock so a toggle cannot race us,
#            bring the stack up, send, tear it down again.
#
# What this deliberately does NOT do is make sending reliable. The two gates in
# FINDINGS §22 are unchanged and are the phone's, not ours: its AWDL has to be
# awake, and it has to actually be advertising _airdrop._tcp - which needs
# AirDrop set to Everyone, that setting not having silently expired after ten
# minutes, and the share sheet CLOSED (an open sheet makes it a sender, and a
# sender never advertises for us to find). All this does is remove our own
# ~90 s of self-imposed setup from in front of those gates.
SEND_REPORT="${AIRDROP_SEND_REPORT:-$HOME/.opendrop/discover.last.json}"
# Ceiling, not a duration - the browse stops the moment a receiver appears, so
# the only thing this buys is how long a FAILURE takes. Every discovery failure
# in this project has been categorical (the phone either advertises or it does
# not); nothing has ever turned up late. Shorter than airdrop.sh's 45 s because
# this one is user-facing and a right-click that hangs for a minute is worse
# than one that says "not found" and lets you re-arm the phone.
SEND_FIND_TIME="${AIRDROP_SEND_FIND_TIME:-25}"
# Reuse a discovery report younger than this instead of browsing again. THE
# WHOLE POINT of the quick-send path: a second file to the same phone should
# not pay for a second browse. Stale reports have burned this project before
# (a three-hour-old empty report read as an opendrop crash), so this is bounded
# tightly AND self-correcting - if a send against a reused report fails, the
# caller re-browses and tries once more, which turns a stale report into a
# slow success rather than a confusing failure.
SEND_REPORT_TTL="${AIRDROP_SEND_REPORT_TTL:-90}"

# Register the Continuity advert that wakes the phone's AWDL, if one is not
# already up. The REGISTERED INSTANCE is the test, not a live process (§36):
# the mt7921 is a combo Wi-Fi/BT part, so bringing the radio up resets the
# shared controller and kills any advert started beforehand. Hence this runs
# AFTER the stack is up, never before.
#
# Non-fatal throughout. §22 could not establish that the advert does anything -
# the one experiment was confounded by a phone whose AWDL was already awake -
# so failing the send because the advert did not register would be refusing to
# try on the strength of a mechanism we have never actually measured.
send_ble_wake() {
  local n
  n=$(sudo -n "$HELPER" ble-adv-count 2>/dev/null || echo 0)
  if [ "${n:-0}" != "0" ]; then
    log "send: BLE advert already registered ($n instance)"
    return 0
  fi
  # All-zero contact hashes. §22 quotes Stute et al: a receiver wakes if a
  # contact hash matches OR if it is discoverable by Everyone, and Everyone is
  # the mode this whole path assumes. Real hashes would only matter for a
  # contacts-only target, which cannot see us anyway - our hashes are zeros and
  # no contact match is possible. Wire format lives in tools/blewake.sh.
  if sudo -n "$HELPER" ble-adv "17FF4C000512000000000000000001000000000000000000" \
       >/dev/null 2>&1; then
    SEND_ADV_OURS=1
    log "send: BLE advert registered - giving the phone 3s to react"
    sleep 3
  else
    log "send: could not register a BLE advert; continuing without it"
  fi
}

# Is the discovery report fresh enough to send against without browsing again?
send_report_fresh() {
  local mtime now
  [ -s "$SEND_REPORT" ] || return 1
  mtime=$(stat -c %Y "$SEND_REPORT" 2>/dev/null || echo 0)
  now=$(date +%s)
  [ "$((now - mtime))" -lt "$SEND_REPORT_TTL" ] || return 1
  # Non-empty as JSON, not merely non-empty as a file: `[]` is 2 bytes and
  # passes -s while meaning "found nobody", and sending against it produces
  # opendrop's TypeError traceback rather than a useful message.
  [ "$(jq 'length' "$SEND_REPORT" 2>/dev/null || echo 0)" -gt 0 ]
}

# The receiver to send to: an explicit override, else the first entry in the
# report. NEVER an index. `opendrop send -r` takes index, ID or hostname, and
# an index is positional - with AirDrop on Everyone every Apple device in range
# is a candidate, so index 0 silently redirects the transfer to whichever one
# answered mDNS first. Worse, opendrop's _get_receiver_info() does int(receiver)
# and falls through to len() on IndexError, so a short report gives a traceback
# instead of "no such receiver". An ID cannot do either.
send_receiver() {
  if [ -n "${AIRDROP_RECEIVER:-}" ]; then printf '%s' "$AIRDROP_RECEIVER"; return 0; fi
  jq -r '.[0].id // empty' "$SEND_REPORT" 2>/dev/null
}

send_receiver_name() {
  jq -r --arg id "$1" '(.[] | select(.id == $id) | .name) // $id' "$SEND_REPORT" 2>/dev/null \
    | head -1
}

# Browse for receivers, bounded, and leave a usable report behind.
#
# Every awkward detail here was paid for in airdrop.sh and none of it is
# optional:
#   - SIGINT, not SIGTERM. `opendrop find` blocks forever and writes its report
#     from a finally: block reached via KeyboardInterrupt. Python does not turn
#     SIGTERM into one, so plain `timeout` kills it with no report written -
#     which surfaces much later as "please run 'opendrop find' first".
#   - PYTHONUNBUFFERED. Python block-buffers stdout to a file, so the receiver
#     line sits in an 8 KiB buffer and the poll that exists to notice it never
#     fires in time.
#   - Wait for the REPORT, not for the process. zeroconf.close() tears down
#     threads and does not reliably return; one measured wait hung for 2m10s
#     after the browse had already produced everything we needed.
send_browse() {
  local flog="$RUNDIR/find.log" mtime i found=0
  mtime=$(stat -c %Y "$SEND_REPORT" 2>/dev/null || echo 0)
  : > "$flog"
  PYTHONUNBUFFERED=1 "$OPENDROP" -i awdl0 find > "$flog" 2>&1 &
  local pid=$!
  for i in $(seq $((SEND_FIND_TIME * 2))); do
    kill -0 "$pid" 2>/dev/null || break
    if grep -qE "^\s*[0-9]+\)|Found" "$flog" 2>/dev/null; then
      found=1
      # A beat, so a second receiver one line later is not cut off.
      sleep 2
      break
    fi
    sleep 0.5
  done
  kill -INT "$pid" 2>/dev/null || true
  for i in $(seq 80); do
    kill -0 "$pid" 2>/dev/null || break
    [ "$(stat -c %Y "$SEND_REPORT" 2>/dev/null || echo 0)" -gt "$mtime" ] && break
    sleep 0.25
  done
  kill -9 "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true

  # Distinguish "the phone is not advertising" from "our browse never got off
  # the ground". They need opposite responses, and the second one is a real
  # possibility on the ATTACH path: the daemon's receiver already holds 5353
  # on awdl0, so a second zeroconf in the same place can fail to bind. Reported
  # as "no receiver found" that sends the user off to fiddle with a phone that
  # was never the problem.
  if grep -qiE "address (already in use|not available)|errno 9[89]" "$flog" 2>/dev/null; then
    log "send: browse could not bind 5353 - see $flog"
    SEND_BROWSE_ERR="The discovery browse could not bind mDNS (port 5353).
Something else on this machine holds it - most likely the running receiver.
Try again with the AirDrop toggle OFF, which gives the send its own stack."
    return 1
  fi
  [ "$found" = 1 ] || return 1
  # Found a line, but the report is what `send` actually reads. If the browse
  # printed a receiver and then failed to write the report, sending would read
  # whatever was there before - which is the stale-report failure again.
  [ "$(stat -c %Y "$SEND_REPORT" 2>/dev/null || echo 0)" -gt "$mtime" ] || {
    log "send: browse found a receiver but wrote no report"
    return 1
  }
  return 0
}

send_one() {
  local file="$1" rcv="$2"
  log "send: $file -> $rcv"
  "$OPENDROP" -i awdl0 send -r "$rcv" -f "$file" >> "$LOG" 2>&1
}

# Everything the user needs to do on the phone, in one place. Printed on the
# discovery failure because that is the only failure this path has ever had,
# and "not found" without this is unactionable.
send_no_receiver_help() {
  # A browse that failed for a reason of OUR own says so instead, because none
  # of the phone advice below would help.
  if [ -n "${SEND_BROWSE_ERR:-}" ]; then
    printf '%s\n' "$SEND_BROWSE_ERR" >&2
    return 0
  fi
  cat >&2 <<'EOF'
No AirDrop receiver found.

This is nearly always the phone's state, not the radio. On the phone:

  1. Settings > General > AirDrop > Everyone for 10 Minutes.
     It EXPIRES back to Contacts Only, silently, and nothing on this side can
     see that it has. Re-arm it and try again - check this first, it is the
     cheapest explanation.
  2. CLOSE the share sheet. An open share sheet makes the phone a sender, and
     a sender never advertises itself for us to find. This is the opposite of
     what receiving needs, which is why it catches people out.
  3. Unlock it and leave it unlocked.
EOF
}

cmd_send() {
  [ $# -gt 0 ] || { echo "usage: airdropd send <file> [file...]" >&2; return 2; }

  local f files=()
  for f in "$@"; do
    [ -f "$f" ] || { echo "airdropd: not a file: $f" >&2; return 2; }
    [ -r "$f" ] || { echo "airdropd: not readable: $f" >&2; return 2; }
    files+=("$f")
  done
  [ -x "$OPENDROP" ] || { echo "airdropd: missing or not executable: $OPENDROP" >&2; return 1; }

  # ATTACH or OWN. Note the fd: cmd_run uses 9, so a send that ends up owning
  # the stack must use the same one for the lock to mean the same thing.
  # Installed for BOTH modes, because both leave something behind that has to
  # be cleaned up: OWN leaves a whole radio stack, ATTACH leaves a BLE advert
  # that would otherwise keep broadcasting indefinitely with nothing in any UI
  # to say so. What it actually tears down is decided inside, by SEND_OWNED -
  # an ATTACH send must never take the running daemon's radio down on its way
  # out, which would turn "I sent a photo" into "the bar went off by itself".
  SEND_OWNED=0
  trap 'send_cleanup; exit 130' INT TERM
  trap send_cleanup EXIT

  local owned=0
  exec 9>>"$LOCK"
  if flock -n 9; then
    owned=1
  fi

  if [ "$owned" = 1 ]; then
    # Nothing was running, so we are responsible for the whole stack. Same
    # preconditions cmd_run checks - a send is the first thing a new user will
    # try, and "awdl0 never appeared" is a much worse first experience than
    # being told the sudoers rule is missing.
    if ! sudo -n "$HELPER" status >/dev/null 2>&1; then
      echo "airdropd: cannot run $HELPER without a password." >&2
      echo "  A right-click has no tty, so this must be passwordless. See daemon/README.md." >&2
      return 1
    fi
    if [ "$DUALCHAN" = 1 ] && [ ! -x /usr/local/bin/airdrop-go-hostapd ]; then
      echo "airdropd: AIRDROP_DUALCHAN=1 but /usr/local/bin/airdrop-go-hostapd is missing." >&2
      return 1
    fi
    echo $$ >&9
    SEND_OWNED=1
    set_state waking "send"
    log "send: nothing was running - bringing the stack up for this send"
    avahi_stop
    if ! stack_up; then
      echo "airdropd: could not bring the stack up - see $LOG" >&2
      return 1
    fi
    set_state sending "ch $BUILT_CHAN"
  else
    # THE LOCK IS NOT ENOUGH TO CONCLUDE THE STACK IS UP, in two ways.
    #
    # Falsely ATTACH: cmd_status takes the same lock, briefly, on every waybar
    # poll - every 2 s, forever. A send that starts inside that window finds
    # the lock held, concludes a daemon is running, and browses on an awdl0
    # that does not exist. Rare, but the failure it produces ("no receiver
    # found") points at the phone, which is the one place it is not.
    #
    # Genuinely ATTACHed but not up: the daemon holds the lock from the moment
    # it starts, and is legitimately in `waking`, `switching` or `error` for
    # seconds at a time with no stack behind it. Same wrong answer.
    #
    # awdl0 answers both. It exists only when owl is running, which is the
    # thing a send actually needs.
    if ! ip link show awdl0 >/dev/null 2>&1; then
      echo "airdropd: something else holds the lock but awdl0 is not up." >&2
      echo "  If the bar is mid-bring-up, wait for it to read on and try again." >&2
      echo "  State: $(cmd_status)" >&2
      return 1
    fi
    log "send: attaching to the running daemon's stack"
  fi

  send_ble_wake

  # Fresh report? Skip the browse entirely - this is what makes a second file
  # to the same phone nearly instant.
  local browsed=0
  if send_report_fresh; then
    log "send: reusing a discovery report from $(( $(date +%s) - $(stat -c %Y "$SEND_REPORT") ))s ago"
  else
    browsed=1
    if ! send_browse; then
      send_no_receiver_help
      return 1
    fi
  fi

  local rcv name rc=0
  rcv=$(send_receiver)
  if [ -z "$rcv" ]; then
    send_no_receiver_help
    return 1
  fi
  name=$(send_receiver_name "$rcv")
  echo "sending to ${name:-$rcv}"

  local first=1
  for f in "${files[@]}"; do
    if send_one "$f" "$rcv"; then
      echo "sent: $(basename "$f")"
    elif [ "$first" = 1 ] && [ "$browsed" = 0 ]; then
      # THE SELF-CORRECTION the reused report is only safe because of. The one
      # plausible reason a first send fails against a reused report is that the
      # report is stale - the phone moved, slept, or re-armed with a new ID -
      # so browse once and try that file again. Only on the FIRST file, and
      # only when we did not already browse: a failure after a fresh browse is
      # a real failure and retrying it just doubles the wait.
      log "send: first send failed on a reused report - re-browsing"
      browsed=1
      if send_browse && rcv=$(send_receiver) && [ -n "$rcv" ] && send_one "$f" "$rcv"; then
        echo "sent: $(basename "$f")"
      else
        echo "FAILED: $(basename "$f")" >&2
        rc=1
      fi
    else
      echo "FAILED: $(basename "$f")" >&2
      rc=1
    fi
    first=0
  done

  # Each file is its own transfer and its own Accept on the phone: opendrop's
  # `-f` takes exactly one file and there is no multi-file request in it. Worth
  # saying out loud, because selecting five files in Thunar and then being
  # asked five times looks like a bug if you were not told.
  [ "${#files[@]}" -gt 1 ] && echo "(${#files[@]} files = ${#files[@]} separate transfers, one Accept each)"

  return $rc
}

# Deliberately not `cleanup`: that one also kills BLE_PID/HEALTH_PID, which
# belong to a receiving daemon that a send does not have.
#
# The advert goes in BOTH modes - we registered it, so we remove it. Only the
# radio stack and the state file are conditional on having owned them.
send_cleanup() {
  if [ "${SEND_ADV_OURS:-0}" = 1 ]; then
    sudo -n "$HELPER" ble-adv-stop >/dev/null 2>&1
  fi
  if [ "${SEND_OWNED:-0}" = 1 ]; then
    teardown
    set_state off
    log "send: stack down"
  fi
  # Explicit, so the EXIT trap cannot end on a failed test and muddy what the
  # caller sees. bash preserves the original status across an EXIT trap, but
  # only for as long as nobody adds an `exit` in here later.
  return 0
}

cmd_status() {
  if [ ! -r "$STATE" ]; then echo '{"state":"off"}'; return 0; fi
  # The state file outlives the daemon, so on its own it can lie. It lies in
  # exactly one way that matters: a toggle nudges "waking" and then the launch
  # loses the flock race against the previous instance's cleanup, so the click
  # is swallowed and the bar sits on "drop on" forever with nothing running.
  # If the lock is free, nothing is running, whatever the file says.
  if ! grep -q '"state":"off"' "$STATE" 2>/dev/null \
     && flock -n 8 8>>"$LOCK" 2>/dev/null; then
    echo '{"state":"off"}'
    return 0
  fi
  cat "$STATE"
}

cmd_stop() {
  if [ -r "$LOCK" ]; then
    local pid; pid=$(cat "$LOCK" 2>/dev/null)
    [ -n "$pid" ] && kill "$pid" 2>/dev/null && { echo "stopped"; return 0; }
  fi
  echo "not running" >&2
  return 1
}

case "${1:-run}" in
  run)    cmd_run ;;
  status) cmd_status ;;
  stop)   cmd_stop ;;
  send)   shift; cmd_send "$@" ;;
  *) echo "usage: airdropd [run|status|stop|send <file>...]" >&2; exit 2 ;;
esac
