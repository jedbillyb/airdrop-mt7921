#!/bin/bash
# Ask the user whether to accept an incoming AirDrop transfer.
#
#   airdrop-confirm "<sender name>" "<what they are sending>"
#
# Exit 0 = accept, non-zero = decline. OpenDrop's handle_ask calls this via
# patches/opendrop-ask-confirm.patch and refuses the transfer on non-zero.
#
# WHY THIS EXISTS: opendrop 0.13.0's `handle_ask` accepts unconditionally - it
# returns 200 with the machine name and there is no prompt and no hook. That is
# tolerable for a research harness you launch by hand for one transfer. It is
# not tolerable for an always-on receiver, where it means anyone in range with
# AirDrop set to Everyone can put files on the machine unattended and unlogged.
# So the confirmation is a REQUIREMENT of the always-on design, not a nicety.
#
# ASKING IS TRIED THREE WAYS, most native first, and every one of them fails
# closed. The original note said notify-send was unusable because no
# notification daemon ran on the author's box: the call would return success
# having shown nobody anything, the worst possible failure for a security
# prompt. That objection is correct, so it is answered rather than ignored -
# we ask the bus whether anyone actually owns org.freedesktop.Notifications
# before trusting it, and only a literal action name on stdout accepts.
#
# swaynag alone was not enough, because it does not exist outside sway. On any
# other compositor this hook could not ask, so it declined - which means every
# incoming transfer was refused, silently, with the daemon otherwise healthy.
set -u

SENDER="${1:-unknown sender}"
DETAIL="${2:-}"
# Refuse rather than accept if we cannot ask. A prompt that fails open is not a
# prompt. This is the branch that runs if swaynag is missing, if there is no
# Wayland display (a daemon started outside the session), or if the user's
# session has gone away - and in every one of those cases there is nobody
# present to consent, so the answer is no.
TIMEOUT="${AIRDROP_CONFIRM_TIMEOUT:-45}"

log() { printf '[airdrop-confirm] %s\n' "$*" >&2; }

# The swaynag check used to live HERE, before any attempt to ask. On a
# compositor that is not sway it exited on this line every time, so every
# incoming transfer was refused while the daemon looked perfectly healthy.
# It now sits at the end of the cascade, where "no way to ask" is a real
# conclusion rather than a premature one.
# IS ANYONE THERE? The question is not "are we under Wayland" but "is there a
# graphical session able to show a prompt at all". A session bus counts: the
# notification below does not require Wayland and works fine under X11.
# Testing for Wayland alone declined every transfer on an X11 desktop with a
# perfectly good notification daemon - which is the very fault being fixed
# here, moved from one compositor to another.
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${SWAYSOCK:-}" ] \
   && [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] \
   && [ -z "${DISPLAY:-}" ] && [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
  log "no graphical session visible - DECLINING (nobody to ask)"
  exit 1
fi

MSG="AirDrop: accept file from ${SENDER}?"
[ -n "$DETAIL" ] && MSG="$MSG"$'\n'"$DETAIL"

# WHICH RUNG, when the cascade's order is not what you want. The order below is
# right as a default: it prefers whatever the compositor supplies, because that
# is the prompt most likely to exist and be visible. But it is a default, not a
# law. On a desktop where the notification daemon is themed to match everything
# else, a focus-stealing dialog is a worse experience than the bubble the
# cascade demotes to rung 3, and there is currently no way to say so.
#
# AIRDROP_CONFIRM_UI names one rung and uses only that one:
#
#   auto (default)  the cascade in order, unchanged
#   dialog          the compositor's own dialog (hyprland-dialog)
#   notify          an actionable notification
#   swaynag         swaynag
#
# An explicit choice FAILS CLOSED rather than falling through: if you asked for
# a notification and no notification daemon owns the bus, the answer is that we
# could not ask, not that we quietly used something else. Silently substituting
# a different prompt for a security question is how you end up clicking Accept
# on something you did not read.
CONFIRM_UI="${AIRDROP_CONFIRM_UI:-auto}"
case "$CONFIRM_UI" in
  auto|dialog|notify|swaynag) ;;
  *)
    log "AIRDROP_CONFIRM_UI=$CONFIRM_UI is not one of auto/dialog/notify/swaynag - using auto"
    CONFIRM_UI=auto
    ;;
esac

# True when this rung is the one to use.
want_ui() { [ "$CONFIRM_UI" = auto ] || [ "$CONFIRM_UI" = "$1" ]; }

# 1. THE COMPOSITOR'S OWN DIALOG FIRST, when we are on the compositor it
# belongs to. hyprland-dialog plays exactly the part swaynag plays on sway: it
# draws its own surface and blocks until answered - but it WRITES THE CHOSEN
# BUTTON ON STDOUT, which removes the whole marker-file mechanism below and
# with it the race that mechanism existed to work around. `timeout` supplies
# the deadline the tool does not have, and anything that is not a plain
# "Accept" declines.
#
# UNDER HYPRLAND ONLY. Selecting this branch on the binary's mere presence in
# PATH had it attempted on Sway or X11 as soon as the package happened to be
# installed - and any failure there declines the transfer without ever
# reaching swaynag, which would have worked. The cascade may only shorten
# itself when the next rung is genuinely the right one.
if want_ui dialog \
   && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] \
   && command -v hyprland-dialog >/dev/null 2>&1; then
  ANSWER=$(timeout "$TIMEOUT" hyprland-dialog \
      --title "AirDrop" --apptitle "AirDrop" \
      --text "$MSG" --buttons "Accept;Decline" 2>/dev/null)
  rc=$?
  case "$ANSWER" in
    Accept)  log "accepted by user"; exit 0 ;;
    Decline) log "declined by user"; exit 1 ;;
    *)
      if [ "$rc" -eq 124 ]; then log "no answer within ${TIMEOUT}s - declining"
      else log "no usable answer from hyprland-dialog (rc=$rc) - declining"; fi
      exit 1 ;;
  esac
fi

# 2. swaynag when we are on sway, for the same reason: it is that
# compositor's own prompt, it draws its own surface, and it was working before
# this cascade existed. Jumping straight to it skips the notification branch
# entirely on sway, which is what keeps that setup unchanged.
if want_ui swaynag && [ -n "${SWAYSOCK:-}" ] && command -v swaynag >/dev/null 2>&1; then
  : # fall through to the swaynag implementation at the end of this file
else

# 3. A NOTIFICATION, only once no compositor dialog applies. It lands where
# every other notification lands and is answered without leaving what you were
# doing, which is gentler than a focus-stealing dialog - but it is LAST, not
# first, and that ordering is load-bearing.
#
# Taking this branch whenever something owns org.freedesktop.Notifications
# breaks setups that already worked. On dunst configured with
# `mouse_left_click = do_action`, a notification carrying two actions and no
# default opens a context menu that needs dmenu; with no dmenu the click just
# closes it, notify-send prints nothing, and the hook declines. And libnotify
# older than 0.8 has no -A at all, so notify-send exits with a usage error and
# the hook declines without ever reaching swaynag sitting right there. Trying
# the compositor's own dialog first leaves both of those untouched.
#
# The daemon still has to own the bus name for this branch to run. And since
# -A prints only the chosen action's name, nothing but a literal "accept"
# accepts: timeout, dismissal, a click elsewhere, a daemon that dies
# mid-prompt, all decline.
if want_ui notify \
   && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] \
   && command -v notify-send >/dev/null 2>&1 \
   && command -v gdbus >/dev/null 2>&1 \
   && [ "$(gdbus call --session --dest org.freedesktop.DBus \
             --object-path /org/freedesktop/DBus \
             --method org.freedesktop.DBus.NameHasOwner \
             org.freedesktop.Notifications 2>/dev/null)" = "(true,)" ]; then
  # -u critical: most daemons keep critical notifications on screen until they
  # are answered. A consent prompt that expires on its own after five seconds
  # would be an implicit decision dressed up as a silent decline.
  #
  # -A implies --wait and so blocks forever; `timeout` supplies the deadline.
  ANSWER=$(timeout "$TIMEOUT" notify-send \
      -a "AirDrop" -u critical -i "network-wireless-symbolic" \
      -A "accept=Accept" -A "decline=Decline" \
      "AirDrop - ${SENDER}" "${DETAIL:-Incoming file}" 2>/dev/null)
  rc=$?
  case "$ANSWER" in
    accept)  log "accepted by user"; exit 0 ;;
    decline) log "declined by user"; exit 1 ;;
    *)
      if [ "$rc" -eq 124 ]; then log "no answer within ${TIMEOUT}s - declining"
      else log "notification gave no usable answer (rc=$rc) - declining"; fi
      exit 1 ;;
  esac
fi

fi

# 4. swaynag, unchanged below. Under sway it is reached before the
# notification, by the SWAYSOCK check above; everywhere else it is the last
# rung. Not finding it is no longer the end of the road, it is the end of a
# cascade.
if ! want_ui swaynag; then
  log "AIRDROP_CONFIRM_UI=$CONFIRM_UI could not be used - DECLINING (asked for one prompt, will not substitute another)"
  exit 1
fi
if ! command -v swaynag >/dev/null 2>&1; then
  log "no notification daemon, no hyprland-dialog, no swaynag - DECLINING (cannot ask, so cannot consent)"
  exit 1
fi

# swaynag has no built-in timeout and no exit code that distinguishes the
# buttons, so both are built here: a marker file per button, and a poll that
# gives up after TIMEOUT. Leaving an unanswered prompt on screen forever would
# wedge the transfer AND the daemon.
#
# BOTH BUTTONS WRITE A MARKER, and the answer is whichever marker appears -
# never inferred from swaynag having exited. `--button-dismiss-no-terminal`
# dismisses first and runs the command from a DETACHED CHILD, so swaynag is
# gone before its own action has run. The previous version waited on swaynag
# and then tested for the Accept marker, which lost that race by two
# milliseconds, every single time:
#
#   /run/user/1000/airdrop-accept.LQtoEz  mtime 21:42:48.416265
#   opendrop logged "user declined"       at    21:42:48.418
#
# Every accept became a 403 and the phone sat on "Waiting" - and because the
# marker was written after the check, it was never cleaned up either, so the
# orphans in XDG_RUNTIME_DIR were the only evidence it had ever been clicked.
BASE=$(mktemp -u "${XDG_RUNTIME_DIR:-/tmp}/airdrop-confirm.XXXXXX")
ACCEPT="$BASE.accept"
DECLINE="$BASE.decline"
rm -f "$ACCEPT" "$DECLINE"

# Every exit path, including the timeout, takes the markers and the prompt with
# it. Nothing of ours outlives this script.
NAG=""
cleanup() {
  [ -n "$NAG" ] && kill "$NAG" 2>/dev/null
  rm -f "$ACCEPT" "$DECLINE"
}
trap cleanup EXIT

swaynag \
  --type warning \
  --message "$MSG" \
  --button-dismiss-no-terminal "Accept" "/bin/sh -c 'touch \"$ACCEPT\"'" \
  --button-dismiss-no-terminal "Decline" "/bin/sh -c 'touch \"$DECLINE\"'" \
  >/dev/null 2>&1 &
NAG=$!

# Poll ten times a second: fast enough that the answer is not perceptibly
# delayed, slow enough to be free next to a human pressing a button.
ANSWER=""
TICKS=$((TIMEOUT * 10))
# Grace after swaynag exits, for the detached child that is about to write.
# One second is three orders of magnitude more than the 2 ms that was lost.
GRACE=10
waited=0
while :; do
  [ -e "$ACCEPT" ]  && { ANSWER=accept;  break; }
  [ -e "$DECLINE" ] && { ANSWER=decline; break; }
  if ! kill -0 "$NAG" 2>/dev/null; then
    g=0
    while [ "$g" -lt "$GRACE" ]; do
      [ -e "$ACCEPT" ]  && { ANSWER=accept;  break; }
      [ -e "$DECLINE" ] && { ANSWER=decline; break; }
      sleep 0.1
      g=$((g + 1))
    done
    break
  fi
  [ "$waited" -ge "$TICKS" ] && break
  sleep 0.1
  waited=$((waited + 1))
done

# Three outcomes, three messages. The old single line said "declined or timed
# out", which is how a lost race spent an evening looking like a slow user.
case "$ANSWER" in
  accept)
    log "accepted by user"
    exit 0 ;;
  decline)
    log "declined by user"
    exit 1 ;;
  *)
    log "no answer within ${TIMEOUT}s - declining"
    exit 1 ;;
esac
