#!/bin/bash
# The ONLY privileged entry point. Install root-owned and grant NOPASSWD on
# exactly this path - never on iw/ip/tcpdump/owl directly.
#
#   sudo install -o root -g root -m 755 daemon/airdrop-helper /usr/local/bin/
#   printf 'jed ALL=(root) NOPASSWD: /usr/local/bin/airdrop-helper\n' \
#     | sudo tee /etc/sudoers.d/zz-airdrop >/dev/null
#   sudo chmod 440 /etc/sudoers.d/zz-airdrop
#
# WHY A WRAPPER RATHER THAN AN ALLOWLIST OF COMMANDS: `sudo tcpdump -w <path>`
# is an arbitrary-file-write-as-root primitive, so NOPASSWD on tcpdump is
# indistinguishable from NOPASSWD on everything. `iw` and `ip` are nearly as
# bad. This wrapper takes a fixed verb, accepts no free-form paths, and does a
# closed set of things, so what is actually granted is what it can do.
#
# It exists because waybar has NO TTY: airdrop.sh's `sudo -v` simply hangs
# there, and this box has NOPASSWD only for xbps-install, wg-quick,
# fprintd-restart and poweroff/reboot. Same pattern as the existing
# /etc/sudoers.d/zzz-swaylock-fp-restart entry.
set -u

PHY="${PHY:-}"
IFACE="${IFACE:-}"
MON=mon0
MONA=mon1
GO=go0
GO_HOSTAPD=/usr/local/bin/airdrop-go-hostapd
GO_CONF=/run/airdrop-go-hostapd.conf
GO_LOG=/run/airdrop-go-hostapd.log

if [ "$(id -u)" != "0" ]; then
  echo "airdrop-helper: must run as root (via sudo)" >&2
  exit 1
fi

# Resolve the Wi-Fi interface here rather than trusting an argument. A caller
# who could name the interface could name anything, which is most of the point
# of not allowlisting `iw` in the first place.
#
# Must skip our own monitor vifs. They are mt7921-driven too and `mon0`/`mon1`
# sort BEFORE `wlp2s0`, so a plain driver match picks a monitor vif whenever the
# stack is up - and then `status` reports assoc=false, chan=null about an
# interface that has no association to report, while the real link is fine.
# airdrop.sh gets away with the naive loop only because it resolves the
# interface before creating any vifs; this can be called at any time.
if [ -z "$IFACE" ]; then
  for d in /sys/class/net/*/device/driver; do
    case "$(basename "$(readlink -f "$d")")" in
      mt7921*)
        cand=$(basename "$(dirname "$(dirname "$d")")")
        [ "$(iw dev "$cand" info 2>/dev/null | awk '/^\ttype /{print $2}')" = "managed" ] \
          || continue
        IFACE=$cand; break ;;
    esac
  done
fi

# The phy that carries this interface. The default used to be a hardcoded
# phy0, which breaks as soon as the driver has been reloaded - the card comes
# back as phy1 - or on any machine with a second radio. `iw phy phy0 interface
# add` then exits ENOENT, which the daemon reports as "no privilege or go0
# setup failed", sending you to look at sudoers for a fault that is not there.
# airdrop.sh already derives it from the interface; do the same here.
if [ -z "$PHY" ] && [ -n "$IFACE" ]; then
  PHY=$(basename "$(readlink -f "/sys/class/net/$IFACE/phy80211")" 2>/dev/null)
  # Fail rather than fall back to phy0. With an interface in hand but no way
  # to tell which phy carries it, `phy0` is a GUESS - and on a multi-radio
  # machine, or after a device reset, it creates the monitor on the wrong
  # radio. That is precisely the failure this change removes; reintroducing it
  # as a fallback would make no sense.
  if [ -z "$PHY" ]; then
    echo "airdrop-helper: cannot resolve the phy carrying $IFACE" >&2
    exit 1
  fi
fi
# With no interface at all, keep the old default: there is nothing to derive.
PHY="${PHY:-phy0}"

# AFTER $PHY is final, not before. On main this read `ieee80211/phy0/mt76`,
# which exists but is the WRONG RADIO whenever the card is not phy0 - after a
# driver reload, or on a machine with a second one. The runtime-pm and
# deep-sleep writes below then land on someone else's device and silently do
# nothing here, which presents as the "monitor captures nothing" failure the
# README documents rather than as a wrong path.
#
# (An earlier version of this comment claimed main produced an empty
# `ieee80211//mt76`. That was wrong: the empty path only existed between
# moving the default and this line, i.e. inside this change itself.)
MT76=/sys/kernel/debug/ieee80211/$PHY/mt76

usage() {
  cat >&2 <<'EOF'
usage: airdrop-helper <verb> [chan]

  up            create the monitor pair, disable runtime PM, report the channel
  down          remove the monitor vifs and restore runtime PM
  go-up <chan>  P2P-GO mode: bring up go0 on <chan>, alias mon0 to its MAC -
                gets AWDL its own channel independent of the AP's (6/36/44/149
                only - the set owl itself accepts; see mt7921-dual-channel)
  go-down       tear down go0/hostapd/mon0 from go-up, restore runtime PM
  wifi-reset    down + go-down, PLUS rfkill-unblock and bring the managed
                interface back up. For manual "THE WORKING RECIPE" testing
                that ran `ip link set <iface> down` by hand and never
                restored it - down/go-down deliberately don't touch that
                because KEEP_WIFI mode never takes it down, but a stuck
                keybinding needs to cover the manual path too.
  status        print JSON: vifs present, channel, association state
  ap-channel    print the channel the managed interface is associated on
  ble-adv <hex> register an Apple Continuity BLE advertisement (see below)
  ble-adv-stop  remove it again
  ble-adv-count print how many advertising instances the controller holds
                (all owners, not just ours - manual diagnostic)

Never takes a free-form path or command - <chan> is validated against a fixed
list, and <hex> against a strict length and character class. See the header
for why.
EOF
  exit 2
}

# Where we record the advertising instance we claimed, so teardown removes that
# one and nothing else. Never caller-supplied, for the same reason the channel
# list is fixed: a caller who can name the instance can clobber an instance
# registered by something else on the system.
BLE_STATE=/run/airdrop-ble-instance

# The controller hands out advertising instances from 1 upward, so another tool
# advertising on this host usually holds instance 1. Claiming a fixed instance
# would remove that tool's advert and leave it with no way to know (#15), so we
# take the lowest instance the controller reports as free instead. Reclaims the
# one we recorded if it is still registered: that is a leftover of ours from a
# run that died before teardown, and an advert nobody owns keeps broadcasting
# indefinitely while showing up in no UI.
ble_pick_instance() {
  local info max count used n mine i
  info=$(timeout 5 btmgmt advinfo 2>/dev/null) || return 1
  max=$(printf '%s\n' "$info" | grep -oP 'Max instances:\s*\K[0-9]+' | head -1)
  [ -n "$max" ] && [ "$max" -gt 0 ] || return 1

  # The list follows the "Instances list with N item(s)" line, one id per line.
  # The exact rendering of those lines is btmgmt's business and has changed
  # shape before, so read the first integer of each and check what we got
  # against the count btmgmt itself declared.
  count=$(printf '%s\n' "$info" | grep -oP 'Instances list with\s*\K[0-9]+' | head -1)
  count=${count:-0}
  used=$(printf '%s\n' "$info" | sed -n '/Instances list with/,$p' | tail -n +2 \
         | grep -oP '^\s*(Instance:\s*)?\K[0-9]+')
  n=$(printf '%s\n' "$used" | grep -c '[0-9]')

  # If the two disagree we cannot say WHICH instances are taken, and guessing
  # wrong is how we would remove somebody else's advert (#15). The kernel hands
  # instances out from 1 upward, so treat the first `count` as taken and look
  # above them: that gives up a free low slot, which costs nothing, rather than
  # risking a slot that is not ours.
  if [ "$n" -ne "$count" ]; then
    used=$(seq 1 "$count" 2>/dev/null)
  fi

  # An instance still listed and still named by our record is a leftover of ours
  # from a run that died before teardown. Reclaim it rather than leak it: an
  # advert nobody owns keeps broadcasting indefinitely and shows up in no UI.
  mine=$(cat "$BLE_STATE" 2>/dev/null)
  case "$mine" in
    ''|*[!0-9]*) mine= ;;
  esac
  if [ -n "$mine" ] && printf '%s\n' "$used" | grep -qx "$mine"; then
    timeout 10 btmgmt rm-adv "$mine" </dev/null >/dev/null 2>&1 || true
    printf '%s\n' "$mine"
    return 0
  fi

  i=1
  while [ "$i" -le "$max" ]; do
    if ! printf '%s\n' "$used" | grep -qx "$i"; then
      printf '%s\n' "$i"
      return 0
    fi
    i=$(( i + 1 ))
  done
  return 1
}

ap_channel() {
  iw dev "$IFACE" info 2>/dev/null | grep -oP 'channel \K[0-9]+'
}

case "${1:-}" in
  ap-channel)
    ap_channel
    ;;

  up)
    mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug
    # THE PAIR (FINDINGS §14): a `flags active` vif alone is stuck at 5180
    # forever, but one created alongside an already-present plain vif rides its
    # channel at full reception and can ACK. Order matters; mon0 must exist
    # first. Under KEEP_WIFI the managed vif owns the channel context, so
    # neither monitor vif is tuned here at all - the retune would be EBUSY and
    # the channel we want is the one the AP already holds (§38).
    iw dev $MONA del 2>/dev/null
    iw dev $MON del 2>/dev/null
    iw phy "$PHY" interface add $MON type monitor || exit 1
    ip link set $MON up || exit 1
    echo 0 > "$MT76/runtime-pm" 2>/dev/null
    echo 0 > "$MT76/deep-sleep" 2>/dev/null
    if iw phy "$PHY" interface add $MONA type monitor flags active 2>/dev/null; then
      ip link set $MONA up 2>/dev/null
      echo 0 > "$MT76/runtime-pm" 2>/dev/null
      echo 0 > "$MT76/deep-sleep" 2>/dev/null
    fi
    printf '{"iface":"%s","mon":"%s","active":%s,"chan":%s}\n' \
      "$IFACE" "$MON" \
      "$(ip link show $MONA >/dev/null 2>&1 && echo true || echo false)" \
      "$(ap_channel || echo null)"
    ;;

  go-up)
    # P2P-GO + MAC-aliased injection (mt7921-dual-channel). Gives AWDL a
    # channel independent of the AP's, at the cost of ~40-590ms added uplink
    # latency while go0 is up (measured, see that repo). Not yet proven for a
    # real file transfer or for active-monitor ACKs against a GO chanctx -
    # this is the newer, less-tested mode; `up`/`down` remain the default.
    chan="${2:-}"
    # THE CHANNEL SET, PLACE 1 OF 3. It must match `owl-start` below and owl's
    # own switch in owl's daemon/owl.c - keep the three in step. 132 used to be
    # here and owl does not support it, so asking for it built a GO fine and
    # then owl exited immediately, surfacing as the unrelated-sounding "awdl0
    # never appeared". Nothing gets widened here without widening all three.
    case "$chan" in
      6) hw=g ;;
      36|44|149) hw=a ;;
      *) echo "airdrop-helper: cannot follow to ch$chan (buildable: 6/36/44/149)" >&2; exit 1 ;;
    esac
    if [ ! -x "$GO_HOSTAPD" ]; then
      echo "airdrop-helper: $GO_HOSTAPD missing - see daemon/README.md" >&2
      exit 1
    fi
    owner=$(stat -c '%U' "$GO_HOSTAPD")
    if [ "$owner" != "root" ]; then
      echo "airdrop-helper: $GO_HOSTAPD must be root-owned (is $owner)" >&2
      exit 1
    fi
    mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug
    pkill -f "^$GO_HOSTAPD " 2>/dev/null
    iw dev $MON del 2>/dev/null
    iw dev $GO del 2>/dev/null
    iw phy "$PHY" interface add $GO type __p2pgo || exit 1
    # mon0 (below) is deliberately MAC-aliased to go0, so once owl derives
    # awdl0's link-local address from mon0's MAC, go0's own auto-assigned
    # link-local address is byte-for-byte identical to awdl0's. ifaddr/
    # zeroconf (what opendrop uses for mDNS) resolve "which interface" purely
    # by matching that IP string, and pick whichever adapter enumerates
    # first - go0, a dead-end local vif with no path to any AWDL peer -
    # instead of awdl0. Silent failure: opendrop announces successfully,
    # zeroconf reports no error, and the _airdrop._tcp record simply never
    # reaches the wire, because it went out go0 instead. go0 has no need of
    # an IP stack at all (it only exists to anchor the chanctx), so disabling
    # IPv6 on it before it can acquire that address removes the ambiguity
    # entirely. Confirmed with a standalone zeroconf test: zero _airdrop._tcp
    # packets on awdl0 without this, full PTR/SRV/TXT/AAAA announce with it.
    sysctl -w net.ipv6.conf.$GO.disable_ipv6=1 >/dev/null 2>&1
    ip link set $GO up || exit 1
    GOMAC=$(cat "/sys/class/net/$GO/address")

    # A fresh, unpublished passphrase every run - never a fixed value that
    # could end up in a log or a repo. Nobody is meant to join this network;
    # it exists only to hold a chanctx open.
    PASS=$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')
    cat > "$GO_CONF" <<EOF
interface=$GO
driver=nl80211
ssid=airdrop-relay-$$
country_code=${REG:-NZ}
ieee80211d=1
hw_mode=$hw
channel=$chan
ieee80211n=1
wmm_enabled=1
auth_algs=1
wpa=2
wpa_passphrase=$PASS
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
ctrl_interface=/var/run/hostapd
EOF
    chmod 600 "$GO_CONF"
    : > "$GO_LOG"
    # setsid is load-bearing: without it hostapd is a child of this sudo
    # invocation's process group, and dies the moment airdrop-helper returns
    # (verified live - it took wlp2s0 through three deauth/reassoc cycles on
    # the way down). owl-start already uses setsid for the same reason.
    setsid env HOSTAPD_P2P_GO=1 "$GO_HOSTAPD" "$GO_CONF" >> "$GO_LOG" 2>&1 &
    for _ in $(seq 60); do
      grep -q 'AP-ENABLED' "$GO_LOG" 2>/dev/null && break
      sleep 0.1
    done
    if ! grep -q 'AP-ENABLED' "$GO_LOG" 2>/dev/null; then
      echo "airdrop-helper: go0 hostapd failed to reach AP-ENABLED, see $GO_LOG" >&2
      pkill -f "^$GO_HOSTAPD " 2>/dev/null
      iw dev $GO del 2>/dev/null
      exit 1
    fi

    iw phy "$PHY" interface add $MON type monitor || exit 1
    ip link set $MON down
    ip link set $MON address "$GOMAC"
    ip link set $MON up || exit 1

    # The ACK pair, exactly as in airdrop.sh's PAIR mode (§13/§14). A plain
    # monitor cannot ACK, and AWDL unicast - which is everything past
    # discovery - needs ACKs, so with mon0 alone the phone's frames go
    # unanswered and it never completes discovery: 100% loss on a ping6 over
    # awdl0 even though go0 is up on the right channel and mDNS is bound.
    # Order matters: the plain vif must already exist and own the channel, or
    # an active vif is stuck on 5180 MHz forever. MAC-aliased to go0 like mon0
    # so monitor TX borrows go0's chanctx.
    if iw phy "$PHY" interface add $MONA type monitor flags active 2>/dev/null; then
      ip link set $MONA down
      ip link set $MONA address "$GOMAC"
      if ip link set $MONA up 2>/dev/null; then
        ACKVIF=$MONA
      else
        iw dev $MONA del 2>/dev/null
        ACKVIF=$MON
      fi
    else
      ACKVIF=$MON
    fi

    echo 0 > "$MT76/runtime-pm" 2>/dev/null
    echo 0 > "$MT76/deep-sleep" 2>/dev/null
    printf '{"go":"%s","mon":"%s","ackvif":"%s","chan":%s}\n' \
      "$GO" "$MON" "$ACKVIF" "$chan"
    ;;

  avahi-down)
    # avahi answers for this host on awdl0 and has no _airdrop._tcp record, so
    # whichever responder the phone hears first decides whether we exist. Done
    # through the helper because that is what the sudoers rule covers - a bare
    # `sudo sv` from the daemon has no rule and fails silently.
    if pgrep -x avahi-daemon >/dev/null 2>&1; then
      sv down avahi-daemon >/dev/null 2>&1 \
        || systemctl stop avahi-daemon >/dev/null 2>&1
      echo '{"avahi":"stopped"}'
    else
      echo '{"avahi":"already-down"}'
    fi
    ;;

  avahi-up)
    sv up avahi-daemon >/dev/null 2>&1 \
      || systemctl start avahi-daemon >/dev/null 2>&1
    echo '{"avahi":"started"}'
    ;;

  go-down)
    pkill -x airdrop-owl 2>/dev/null
    pkill -f "^$GO_HOSTAPD " 2>/dev/null
    ip link set $MONA down 2>/dev/null
    iw dev $MONA del 2>/dev/null
    ip link set $MON down 2>/dev/null
    iw dev $MON del 2>/dev/null
    ip link set $GO down 2>/dev/null
    iw dev $GO del 2>/dev/null
    rm -f "$GO_CONF"
    echo 1 > "$MT76/runtime-pm" 2>/dev/null
    echo 1 > "$MT76/deep-sleep" 2>/dev/null
    echo '{"ok":true}'
    ;;

  owl-start)
    # OWL must run as root: it creates the awdl0 tun interface, and without
    # privilege it starts, prints its banner and never produces one - which
    # surfaces confusingly as "awdl0 never appeared" rather than as a
    # permission error.
    #
    # It is run from a FIXED ROOT-OWNED PATH, never from $OWL_DIR. Running a
    # user-writable binary as root is the same privilege escalation that keeps
    # the sudoers rule off this repo: anything able to write the binary would
    # get root. Install it with:
    #   sudo install -o root -g root -m 755 ~/owl/build/daemon/owl \
    #        /usr/local/bin/airdrop-owl
    OWL_BIN=/usr/local/bin/airdrop-owl
    if [ ! -x "$OWL_BIN" ]; then
      echo "airdrop-helper: $OWL_BIN missing - see daemon/README.md" >&2
      exit 1
    fi
    owner=$(stat -c '%U' "$OWL_BIN")
    if [ "$owner" != "root" ]; then
      echo "airdrop-helper: $OWL_BIN must be root-owned (is $owner)" >&2
      exit 1
    fi
    chan="${2:-36}"
    # THE CHANNEL SET, PLACE 2 OF 3 - `go-up` above, and owl's own switch in
    # its daemon/owl.c, which is the one that has the final say. Rejecting it
    # here rather than letting owl reject it turns a silent exit-after-banner
    # into a message that names the channel.
    case "$chan" in
      6|36|44|149) ;;
      *) echo "airdrop-helper: owl cannot run on ch$chan (buildable: 6/36/44/149)" >&2; exit 1 ;;
    esac
    # go-up's mon0 is a single MAC-aliased vif (no ACK-tuned pair needed - it
    # rides go0's own chanctx); up's default pair uses mon1, the `flags
    # active` vif that can ACK while riding the AP's chanctx (§14).
    vif="${3:-$MONA}"

    # Sequence strategy. `pin` was the default here and should not have been:
    # OWL's own channel.h records it measured as REJECTED by iOS 26 (§25, "same
    # phone, same setup, same binary, verbatim 60% ping loss against pin 100%"),
    # because one channel in all 16 slots with no empty slots looks like nothing
    # an Apple device emits. The helper default contradicted the finding.
    #
    # `intersect` is the right shape for THIS configuration. Under P2P-GO the
    # radio is held on one channel by go0's chanctx and OWL's channel switching
    # is a silent no-op - measured, 2425 of 2425 captured frames on 5180 MHz
    # while OWL logged ten switches to 149 and ten back. So we advertise exactly
    # the peer's slots that sit on our channel and leave the rest empty: true,
    # and structurally like a real sequence.
    # The strategy may also come from a file in the CALLER's home. airdropd
    # invokes this helper through `sudo -n` WITHOUT -E, so an environment
    # variable never crosses the privilege boundary: AIRDROP_OWL_STRATEGY is
    # unsettable in practice for anyone driving the daemon rather than running
    # this script by hand. Reinstalling the root binary to try another value
    # is not a reasonable way to run an experiment.
    #
    # The value is validated against the allowlist below before any use, so a
    # user-writable file can only pick among names that are already allowed -
    # it cannot inject anything. Default unchanged.
    # Taken from $4 when the caller supplies it ($2 is the channel and $3 the
    # monitor vif). ROOT NEVER OPENS A PATH THE
    # USER CONTROLS: an earlier version read ~$SUDO_USER/.config/airdrop/
    # strategy here, which a symlink to a root-only file would have echoed
    # back through the error message below, and a FIFO would have hung the
    # helper forever. airdropd reads that file as the user and passes the
    # value; the allowlist check stays here, so the argument can still only
    # name a strategy that was already permitted.
    strategy="${AIRDROP_OWL_STRATEGY:-${4:-}}"
    strategy=$(printf '%s' "$strategy" | tr -dc 'a-z' | head -c 16)
    strategy="${strategy:-intersect}"
    case "$strategy" in
      pin|verbatim|fixed|intersect|widen|rotate) ;;
      *) echo "airdrop-helper: bad strategy $strategy" >&2; exit 1 ;;
    esac

    pkill -x airdrop-owl 2>/dev/null
    # stdbuf -oL so the log is readable live rather than in 4 KiB bursts.
    setsid stdbuf -oL "$OWL_BIN" -i "$vif" -c "$chan" -N -S "$strategy" -vv \
      >> /run/airdrop-owl.log 2>&1 &
    for _ in $(seq 60); do
      ip link show awdl0 >/dev/null 2>&1 && break
      sleep 0.1
    done
    if ip link show awdl0 >/dev/null 2>&1; then
      ip link set awdl0 up 2>/dev/null
      echo '{"awdl0":true}'
    else
      echo '{"awdl0":false}'
      exit 1
    fi
    ;;

  owl-stop)
    pkill -x airdrop-owl 2>/dev/null
    echo '{"ok":true}'
    ;;

  down)
    pkill -x airdrop-owl 2>/dev/null
    ip link set $MONA down 2>/dev/null
    iw dev $MONA del 2>/dev/null
    ip link set $MON down 2>/dev/null
    iw dev $MON del 2>/dev/null
    echo 1 > "$MT76/runtime-pm" 2>/dev/null
    echo 1 > "$MT76/deep-sleep" 2>/dev/null
    # Deliberately does NOT touch $IFACE, NetworkManager or wpa_supplicant.
    # Nothing here ever took them down, and bouncing a working association on
    # the way out is the exact outage this design exists to avoid (§38).
    echo '{"ok":true}'
    ;;

  wifi-reset)
    pkill -x airdrop-owl 2>/dev/null
    pkill -f "^$GO_HOSTAPD " 2>/dev/null
    for v in $MONA $MON $GO; do
      ip link set "$v" down 2>/dev/null
      iw dev "$v" del 2>/dev/null
    done
    rm -f "$GO_CONF"
    echo 1 > "$MT76/runtime-pm" 2>/dev/null
    echo 1 > "$MT76/deep-sleep" 2>/dev/null
    rfkill unblock wifi 2>/dev/null
    if [ -n "$IFACE" ]; then
      ip link set "$IFACE" up 2>/dev/null
    else
      # up/managed lookup above only matches an already-managed vif; if the
      # interface got renamed or the driver reset, fall back to any mt7921
      # netdev that isn't one of our own vifs.
      for d in /sys/class/net/*/device/driver; do
        case "$(basename "$(readlink -f "$d")")" in
          mt7921*)
            cand=$(basename "$(dirname "$(dirname "$d")")")
            case "$cand" in "$MON"|"$MONA"|"$GO") continue ;; esac
            ip link set "$cand" up 2>/dev/null ;;
        esac
      done
    fi
    echo '{"ok":true}'
    ;;

  # --- BLE Continuity advert -------------------------------------------------
  #
  # WHY THIS IS HERE AND NOT IN tools/blewake.sh. blewake.sh calls plain `sudo`,
  # which is exactly right for a human at a terminal and useless for everything
  # this daemon does: waybar and a Thunar right-click have no tty, so a sudo
  # that wants a password (or a fingerprint) does not prompt, it hangs. The
  # helper is the one path with a NOPASSWD rule, so the send path has to come
  # through here. blewake.sh keeps its own sudo calls and stays the manual tool.
  #
  # The DATA is built by the caller, unprivileged - it is only the SHA256
  # prefixes of the sender's own contact identifiers (FINDINGS §36, and the wire
  # format in tools/blewake.sh) and nothing about it needs root. Root is needed
  # solely to hand it to btmgmt. So this validates rather than constructs:
  # hex digits only, even length, and no longer than a BLE AD structure can
  # carry. That keeps the granted capability "register one short advertisement"
  # instead of "pass arbitrary arguments to btmgmt as root".
  ble-adv)
    adv="${2:-}"
    case "$adv" in
      *[!0-9A-Fa-f]*|"") echo "airdrop-helper: ble-adv data must be hex" >&2; exit 1 ;;
    esac
    if [ $(( ${#adv} % 2 )) -ne 0 ] || [ "${#adv}" -gt 62 ]; then
      echo "airdrop-helper: ble-adv data must be an even number of hex digits, max 62" >&2
      exit 1
    fi
    if ! inst=$(ble_pick_instance); then
      echo "airdrop-helper: no free advertising instance on the controller" >&2
      exit 1
    fi
    if ! timeout 15 btmgmt add-adv -d "$adv" -g "$inst" </dev/null 2>&1 \
         | grep -q "Instance added"; then
      echo "airdrop-helper: failed to register advertising instance $inst" >&2
      exit 1
    fi
    # Recorded only once the add succeeded, so a failed claim never makes
    # ble-adv-stop remove an instance we do not hold.
    printf '%s\n' "$inst" > "$BLE_STATE"
    printf '{"ok":true,"instance":%s}\n' "$inst"
    ;;

  ble-adv-stop)
    # Only ever removes the instance ble-adv recorded. No record means we have
    # nothing registered, and removing a guessed instance would take down
    # somebody else's advert (#15).
    inst=$(cat "$BLE_STATE" 2>/dev/null)
    case "$inst" in
      ''|*[!0-9]*) ;;
      *) timeout 10 btmgmt rm-adv "$inst" </dev/null >/dev/null 2>&1 || true ;;
    esac
    rm -f "$BLE_STATE"
    echo '{"ok":true}'
    ;;

  # Total advertising instances registered on the controller. Manual diagnostic
  # only - nothing in the daemon calls it. It counts every instance without
  # distinguishing owners (#15), so it cannot answer "is OUR advert up"; that is
  # what the recorded instance in BLE_STATE is for. Useful by hand to confirm
  # §36: the mt7921 is a combo Wi-Fi/BT part, so bringing the radio up resets the
  # shared controller and kills any advert started beforehand.
  ble-adv-count)
    timeout 5 btmgmt advinfo 2>/dev/null \
      | grep -oP 'Instances list with \K[0-9]+' || echo 0
    ;;

  status)
    printf '{"mon":%s,"active":%s,"go":%s,"assoc":%s,"chan":%s}\n' \
      "$(ip link show $MON  >/dev/null 2>&1 && echo true || echo false)" \
      "$(ip link show $MONA >/dev/null 2>&1 && echo true || echo false)" \
      "$(ip link show $GO   >/dev/null 2>&1 && echo true || echo false)" \
      "$(iw dev "$IFACE" link 2>/dev/null | grep -q '^Connected' && echo true || echo false)" \
      "$(ap_channel || echo null)"
    ;;

  *) usage ;;
esac
